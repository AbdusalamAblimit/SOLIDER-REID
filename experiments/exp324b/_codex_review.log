def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--limit_q', type=int, default=None, help='limit num query (smoke)')
    ap.add_argument('--limit_g', type=int, default=None, help='limit num gallery (smoke)')
    ap.add_argument('--batch', type=int, default=32)
    args = ap.parse_args()

    t_start = time.time()
    q_names = list_imgs(QUERY_DIR)
    g_names = list_imgs(GALLERY_DIR)
    if args.limit_q:
        q_names = q_names[:args.limit_q]
    if args.limit_g:
        g_names = g_names[:args.limit_g]
    print(f'query={len(q_names)} gallery={len(g_names)} grid={GRID_H}x{GRID_W} in={IN_W}x{IN_H}')

    # pids / camids
    q_pids = np.array([parse_pid_cam(n)[0] for n in q_names])
    q_camids = np.array([parse_pid_cam(n)[1] for n in q_names])
    g_pids = np.array([parse_pid_cam(n)[0] for n in g_names])
    g_camids = np.array([parse_pid_cam(n)[1] for n in g_names])

    # heavy-occ mask (query visibility_binary.sum() <= THR). p0 primary.
    q_vis_sum = np.zeros(len(q_names), dtype=np.int32)
    for i, nm in enumerate(q_names):
        pose = find_pose('query', nm)
        q_vis_sum[i] = int(pose[1].sum()) if pose is not None else 17  # no-pose -> not occ
    heavy_mask = q_vis_sum <= HEAVY_OCC_THR
    print(f'heavy-occ queries (vis<= {HEAVY_OCC_THR}): {heavy_mask.sum()}/{len(q_names)}')

    # ---- DINO features ----
    t0 = time.time()
    model = load_model()
    print(f'[model] loaded {time.time() - t0:.1f}s')
    q_cls, q_patch = extract_split(model, 'query', q_names, QUERY_DIR, args.batch)
    g_cls, g_patch = extract_split(model, 'gallery', g_names, GALLERY_DIR, args.batch)
    t_feat = time.time() - t_start
    print(f'[timing] feature extraction total {t_feat:.1f}s')

    # ---- representations ----
    tr0 = time.time()
    qr = build_reps('query', q_names, q_cls, q_patch, QUERY_DIR)
    gr = build_reps('gallery', g_names, g_cls, g_patch, GALLERY_DIR)
    print(f'[timing] rep building {time.time() - tr0:.1f}s')

    # ---- distance matrices ----
    te0 = time.time()
    print('computing distmats...')
    dm_cls = holistic_distmat(qr['cls'], gr['cls'])
    dm_mean = holistic_distmat(qr['meanpool'], gr['meanpool'])
    dm_pose = part_maxsim_distmat(qr['pose_parts'], qr['pose_vis'],
                                  gr['pose_parts'], gr['pose_vis'])
    dm_grid = part_maxsim_distmat(qr['grid_parts'], qr['grid_vis'],
                                  gr['grid_parts'], gr['grid_vis'])
    print(f'[timing] distmat {time.time() - te0:.1f}s')

    # ---- eval ----
    methods = [
        ('(a) holistic CLS', dm_cls),
        ('(a) holistic mean-pool', dm_mean),
        ('(b) pose part-MaxSim', dm_pose),
        ('(c) grid part-MaxSim', dm_grid),
    ]
    print('\n================ RESULTS (mAP / R1 / R5 / R10) ================')
    header = f'{"method":28s} | {"ALL query":>28s} | {"HEAVY-OCC query":>28s}'
    print(header)
    print('-' * len(header))
    results = {}
    for name, dm in methods:
        mAP_a, r1_a, r5_a, r10_a = run_eval(dm, q_pids, g_pids, q_camids, g_camids)
        mAP_h, r1_h, r5_h, r10_h = run_eval(dm, q_pids, g_pids, q_camids, g_camids, heavy_mask)
        results[name] = (mAP_a, r1_a, mAP_h, r1_h)
        all_s = f'{mAP_a * 100:5.2f}/{r1_a * 100:5.2f}/{r5_a * 100:5.2f}/{r10_a * 100:5.2f}'
        heavy_s = f'{mAP_h * 100:5.2f}/{r1_h * 100:5.2f}/{r5_h * 100:5.2f}/{r10_h * 100:5.2f}'
        print(f'{name:28s} | {all_s:>28s} | {heavy_s:>28s}')

    # ---- relative comparison ----
    print('\n================ RELATIVE (heavy-occ subset) ================')
    base = results['(a) holistic CLS']
    pose = results['(b) pose part-MaxSim']
    grid = results['(c) grid part-MaxSim']
    print(f'holistic CLS heavy : mAP {base[2]*100:.2f}  R1 {base[3]*100:.2f}')
    print(f'pose-part    heavy : mAP {pose[2]*100:.2f}  R1 {pose[3]*100:.2f}  '
          f'(vs holistic: {(pose[2]-base[2])*100:+.2f} mAP / {(pose[3]-base[3])*100:+.2f} R1)')
    print(f'grid-part    heavy : mAP {grid[2]*100:.2f}  R1 {grid[3]*100:.2f}  '
          f'(vs holistic: {(grid[2]-base[2])*100:+.2f} mAP / {(grid[3]-base[3])*100:+.2f} R1)')
    print(f'pose vs grid heavy : {(pose[2]-grid[2])*100:+.2f} mAP / {(pose[3]-grid[3])*100:+.2f} R1  '
          f'(does pose anchoring help?)')
    print(f'\n[timing] total {time.time() - t_start:.1f}s')


if __name__ == '__main__':
    main()

