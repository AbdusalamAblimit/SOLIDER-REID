   449	            uniq_ids = len(set(int(lab_t[i]) for i in batch_idx))
   450	            print(f'[dry step {s+1}/{args.dry_steps}] bs={len(batch_idx)} '
   451	                  f'uniq_ids={uniq_ids} | total={loss:.4f} id={idl:.4f} '
   452	                  f'tri={tril:.4f} | d_ap={dap:.3f} d_an={dan:.3f} acc={acc:.3f}',
   453	                  flush=True)
