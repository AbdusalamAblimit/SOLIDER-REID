   197	def build_part_pose(patch_grid, kp, vb):
   198	    """Pose-anchored 5-part vectors from one image's patch grid.
   199	    patch_grid: (GRID_H,GRID_W,HIDDEN) float. kp:(17,2) orig pixel, vb:(17,) bool.
   200	    img W,H needed to scale -> passed via globals on caller (we pass kp already
   201	    scaled). Returns (parts (5,HIDDEN) float32, part_vis (5,) bool).
   202	
   203	    NOTE: kp passed here must ALREADY be scaled to grid coords (col,row)."""
   204	    parts = np.zeros((NPARTS, HIDDEN), dtype=np.float32)
   205	    part_vis = np.zeros(NPARTS, dtype=bool)
   206	    for pi, pname in enumerate(PART_NAMES):
   207	        cells = set()
   208	        for ki in PART_GROUPS[pname]:
   209	            if not vb[ki]:
   210	                continue
   211	            cx, cy = kp[ki, 0], kp[ki, 1]
   212	            # (0,0) is the missing sentinel; skip
   213	            if cx <= 0 and cy <= 0:
   214	                continue
   215	            col = int(round(cx))
   216	            row = int(round(cy))
   217	            for dr in range(-POOL_RADIUS, POOL_RADIUS + 1):
   218	                for dc in range(-POOL_RADIUS, POOL_RADIUS + 1):
   219	                    r, c = row + dr, col + dc
   220	                    if 0 <= r < GRID_H and 0 <= c < GRID_W:
   221	                        cells.add((r, c))
   222	        if cells:
   223	            rs = np.fromiter((c[0] for c in cells), dtype=np.int64)
   224	            cs = np.fromiter((c[1] for c in cells), dtype=np.int64)
   225	            parts[pi] = patch_grid[rs, cs].mean(axis=0)
   226	            part_vis[pi] = True
   227	    return parts, part_vis
