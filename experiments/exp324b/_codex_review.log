   252	# ----------------------------------------------------------------------------
   253	# part-MaxSim distance over common-visible parts
   254	# ----------------------------------------------------------------------------
   255	def part_maxsim_distmat(q_parts, q_vis, g_parts, g_vis, device='cuda'):
   256	    """q_parts:(Q,5,D) normalized, q_vis:(Q,5) bool. Same for g.
   257	    For each (q,g) pair: per-part cosine sim only for parts visible in BOTH,
   258	    averaged over common-visible parts -> sim. distance = 1 - sim.
   259	    If no common part -> max distance (2.0).
   260	    Returns distmat (Q,G) numpy."""
   261	    Q, P, D = q_parts.shape
   262	    G = g_parts.shape[0]
   263	    qp = torch.from_numpy(q_parts).to(device)            # (Q,P,D)
   264	    gp = torch.from_numpy(g_parts).to(device)            # (G,P,D)
   265	    qv = torch.from_numpy(q_vis).float().to(device)      # (Q,P)
   266	    gv = torch.from_numpy(g_vis).float().to(device)      # (G,P)
   267	    dist = np.zeros((Q, G), dtype=np.float32)
   268	    chunk = 256
   269	    for qi in range(0, Q, chunk):
   270	        qe = min(qi + chunk, Q)
   271	        qpc = qp[qi:qe]            # (b,P,D)
   272	        qvc = qv[qi:qe]           # (b,P)
   273	        # per-part cosine sim between q part p and g part p (same part index only):
   274	        # (b,P,D) x (G,P,D) -> (b,G,P)
   275	        sim = torch.einsum('bpd,gpd->bgp', qpc, gp)      # (b,G,P)
   276	        # common-visible mask: (b,1,P) * (1,G,P) -> (b,G,P)
   277	        common = qvc.unsqueeze(1) * gv.unsqueeze(0)       # (b,G,P)
   278	        denom = common.sum(dim=2)                         # (b,G)
   279	        sim_sum = (sim * common).sum(dim=2)               # (b,G)
   280	        avg_sim = torch.where(denom > 0, sim_sum / denom.clamp(min=1e-6),
   281	                              torch.full_like(sim_sum, -1.0))  # no common -> sim=-1
   282	        d = 1.0 - avg_sim                                 # (b,G), no-common -> 2.0
   283	        dist[qi:qe] = d.cpu().numpy()
   284	    return dist
   285	
   286	
   287	def holistic_distmat(qf, gf, device='cuda'):
   288	    """Cosine distance on holistic vectors. qf:(Q,D) gf:(G,D). Returns (Q,G)."""
   289	    qt = F.normalize(torch.from_numpy(qf).float().to(device), dim=1)
   290	    gt = F.normalize(torch.from_numpy(gf).float().to(device), dim=1)
   291	    Q = qt.shape[0]
   292	    dist = np.zeros((Q, gt.shape[0]), dtype=np.float32)
   293	    chunk = 512
   294	    for qi in range(0, Q, chunk):
   295	        qe = min(qi + chunk, Q)
   296	        sim = qt[qi:qe] @ gt.t()
   297	        dist[qi:qe] = (1.0 - sim).cpu().numpy()
   298	    return dist
   299	
   300	
   301	# ----------------------------------------------------------------------------
   302	# build all representations for a split
   303	# ----------------------------------------------------------------------------
   304	def build_reps(split, names, cls_arr, patch_arr, img_dir):
   305	    """Build holistic (cls, meanpool), part_pose, part_grid for every image.
   306	    Returns dict of arrays."""
   307	    N = len(names)
   308	    cls = np.asarray(cls_arr, dtype=np.float32)           # (N,768)
   309	    meanpool = np.zeros((N, HIDDEN), dtype=np.float32)
   310	    pose_parts = np.zeros((N, NPARTS, HIDDEN), dtype=np.float32)
   311	    pose_vis = np.zeros((N, NPARTS), dtype=bool)
   312	    grid_parts = np.zeros((N, NPARTS, HIDDEN), dtype=np.float32)
   313	    grid_vis = np.zeros((N, NPARTS), dtype=bool)
   314	    n_nopose = 0
   315	    for i, nm in enumerate(names):
   316	        pg = np.asarray(patch_arr[i], dtype=np.float32)   # (GRID_H,GRID_W,768)
   317	        meanpool[i] = pg.reshape(-1, HIDDEN).mean(axis=0)
   318	        # uniform grid (always available)
   319	        gp, gv = build_part_grid(pg)
   320	        grid_parts[i] = gp
   321	        grid_vis[i] = gv
   322	        # pose-anchored
   323	        pose = find_pose(split, nm)
   324	        if pose is None:
   325	            n_nopose += 1
   326	            continue
   327	        kp, vb = pose
   328	        # need original image size to scale kp
   329	        im = Image.open(os.path.join(img_dir, nm))
   330	        W, H = im.size
