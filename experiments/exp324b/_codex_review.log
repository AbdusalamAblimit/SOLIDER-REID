   133	# ============================================================================
   134	# 2. Lightweight head: shared Linear 768->512 (all parts share it) + BNNeck +
   135	#    ID classifier. Global feat = masked mean over visible projected parts.
   136	# ============================================================================
   137	class PartHead(nn.Module):
   138	    def __init__(self, in_dim=HIDDEN, embed_dim=512, num_classes=0):
   139	        super().__init__()
   140	        # ONE shared linear applied to every part vector independently.
   141	        self.proj = nn.Linear(in_dim, embed_dim, bias=False)
   142	        # BNNeck on the global (masked-mean) feature.
   143	        self.bottleneck = nn.BatchNorm1d(embed_dim)
   144	        self.bottleneck.bias.requires_grad_(False)   # standard BNNeck: no bias
   145	        self.classifier = nn.Linear(embed_dim, num_classes, bias=False)
   146	        self._init()
   147	
   148	    def _init(self):
   149	        nn.init.kaiming_normal_(self.proj.weight, mode='fan_out')
   150	        nn.init.constant_(self.bottleneck.weight, 1.0)
   151	        nn.init.constant_(self.bottleneck.bias, 0.0)
   152	        nn.init.normal_(self.classifier.weight, std=0.001)
   153	
   154	    def project_parts(self, parts):
   155	        """parts: (B,5,768) -> projected (B,5,512). Shared linear over part axis."""
   156	        B, P, D = parts.shape
   157	        flat = parts.reshape(B * P, D)
   158	        proj = self.proj(flat).reshape(B, P, -1)        # (B,5,512)
   159	        return proj
   160	
   161	    @staticmethod
   162	    def masked_mean(proj, vis):
   163	        """proj:(B,5,512), vis:(B,5) bool/float -> global (B,512) masked mean over
   164	        VISIBLE parts. Images with zero visible parts fall back to a plain mean
   165	        (denominator clamped to 1) to avoid NaN; such images are rare."""
   166	        v = vis.float().unsqueeze(-1)                   # (B,5,1)
   167	        s = (proj * v).sum(dim=1)                        # (B,512)
   168	        cnt = v.sum(dim=1).clamp(min=1.0)                # (B,1)
   169	        return s / cnt
   170	
   171	    def forward(self, parts, vis):
   172	        """Returns (cls_score, global_feat_pre_bn, bn_feat).
   173	        cls_score: (B,num_classes) logits  (training).
   174	        global_feat_pre_bn: (B,512) for triplet loss (un-normalized).
   175	        bn_feat: (B,512) after BNNeck (for ID loss in training, for retrieval at test)."""
   176	        proj = self.project_parts(parts)                # (B,5,512)
   177	        glob = self.masked_mean(proj, vis)              # (B,512)
   178	        bn = self.bottleneck(glob)                       # (B,512)
   179	        cls = self.classifier(bn)                        # (B,num_classes)
   180	        return cls, glob, bn
   181	
   182	    @torch.no_grad()
   183	    def encode_parts(self, parts, vis):
   184	        """For part-MaxSim eval: return L2-normalized projected part vectors and
   185	        the visibility mask. parts:(B,5,768) -> (B,5,512) normalized, vis:(B,5)."""
   186	        proj = self.project_parts(parts)                # (B,5,512)
   187	        proj = F.normalize(proj, dim=2)
   188	        proj = proj * vis.float().unsqueeze(-1)          # zero out invisible parts
   189	        return proj
