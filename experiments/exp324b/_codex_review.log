   425	        yt = torch.from_numpy(lab_t[idx]).to(device)                # (BS,)
   426	        head.train()
   427	        cls, glob, bn = head(pt, vt)
   428	        id_loss = ce(cls, yt)
   429	        tri_loss, dap, dan = batch_hard_triplet(glob, yt, margin=args.margin)
   430	        loss = args.id_weight * id_loss + args.tri_weight * tri_loss
   431	        optimizer.zero_grad()
   432	        loss.backward()
   433	        optimizer.step()
   434	        with torch.no_grad():
   435	            acc = (cls.argmax(dim=1) == yt).float().mean().item()
   436	        return loss.item(), id_loss.item(), tri_loss.item(), dap.item(), dan.item(), acc
   437	
   438	    # ---- DRY RUN: few steps, print, exit ----
