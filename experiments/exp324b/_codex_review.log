   160	def extract_split(model, split, names, img_dir, batch_size=32, limit=None):
   161	    """Extract CLS (B,768) + patch grid (B,GRID_H,GRID_W,768) for a split.
   162	    Cache to disk. Returns (cls (N,768) float16, patch (N,GRID_H,GRID_W,768) float16)."""
   163	    if limit is not None:
   164	        names = names[:limit]
   165	    tag = f'{split}_{IN_W}x{IN_H}_n{len(names)}'
   166	    cls_path = os.path.join(CACHE_DIR, f'cls_{tag}.npy')
   167	    patch_path = os.path.join(CACHE_DIR, f'patch_{tag}.npy')
   168	    if os.path.exists(cls_path) and os.path.exists(patch_path):
   169	        print(f'[cache] load {tag}')
   170	        return (np.load(cls_path), np.load(patch_path, mmap_mode='r'))
