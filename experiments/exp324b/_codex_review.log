    97	    camids = np.array([parse_pid_cam(n)[1] for n in names], dtype=np.int64)
    98	    parts = np.zeros((N, NPARTS, HIDDEN), dtype=np.float32)
    99	    vis = np.zeros((N, NPARTS), dtype=bool)
   100	
   101	    model = e324.load_model()
   102	    n_nopose = 0
   103	    t0 = time.time()
   104	    with torch.no_grad():
