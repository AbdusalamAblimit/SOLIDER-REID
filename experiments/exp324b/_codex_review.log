   244	def scale_kp_to_grid(kp, W, H):
   245	    """Scale keypoints from original pixel space to grid (col,row) space."""
   246	    out = kp.copy()
   247	    out[:, 0] = kp[:, 0] / max(W, 1) * GRID_W
   248	    out[:, 1] = kp[:, 1] / max(H, 1) * GRID_H
   249	    return out
