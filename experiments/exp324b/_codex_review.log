   272	@torch.no_grad()
   273	def encode_split(head, parts, vis, device, batch=512):
   274	    """Run head over a whole split's cached part features. Returns:
   275	      bn_feats  : (N,512) BNNeck global feat (for cosine retrieval)
   276	      np_parts  : (N,5,512) L2-normalized projected part vectors (for part-MaxSim)
   277	      np_vis    : (N,5) float
   278	    """
   279	    head.eval()
   280	    N = parts.shape[0]
   281	    bn_all = np.zeros((N, head.bottleneck.num_features), dtype=np.float32)
   282	    pp_all = np.zeros((N, NPARTS, head.bottleneck.num_features), dtype=np.float32)
   283	    for i in range(0, N, batch):
   284	        e = min(i + batch, N)
   285	        pt = torch.from_numpy(parts[i:e]).to(device)
   286	        vt = torch.from_numpy(vis[i:e].astype(np.float32)).to(device)
   287	        _, _, bn = head(pt, vt)
   288	        bn_all[i:e] = bn.cpu().numpy()
   289	        pp = head.encode_parts(pt, vt)                   # (b,5,512) normalized
   290	        pp_all[i:e] = pp.cpu().numpy()
   291	    return bn_all, pp_all, vis.astype(np.float32)
