   122	def find_pose(split, imgname):
   123	    """Pick the PRIMARY person detection (p0). For all-image extraction we have no
   124	    target visibility to match against, so use highest-confidence primary (p0),
   125	    same convention exp323 uses for gallery. Returns (kp(17,2), vb(17,)) or None."""
