   230	def build_part_grid(patch_grid):
   231	    """Uniform 5-band vectors (no pose). Split GRID_H rows into 5 contiguous bands,
   232	    mean-pool each band over all columns. All bands marked visible.
   233	    Returns (parts (5,HIDDEN) float32, part_vis (5,) all True)."""
   234	    parts = np.zeros((NPARTS, HIDDEN), dtype=np.float32)
   235	    bounds = np.linspace(0, GRID_H, NPARTS + 1).astype(int)
   236	    for pi in range(NPARTS):
   237	        r0, r1 = bounds[pi], bounds[pi + 1]
   238	        if r1 <= r0:
   239	            r1 = r0 + 1
   240	        parts[pi] = patch_grid[r0:r1].reshape(-1, HIDDEN).mean(axis=0)
   241	    return parts, np.ones(NPARTS, dtype=bool)
