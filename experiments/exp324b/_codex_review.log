     1	#!/usr/bin/env python3
     2	"""exp324b: Train a LIGHTWEIGHT projection head on top of FROZEN DINOv2-base
     3	pose-anchored 5-part features for occluded person ReID (Occluded-Duke).
     4	
     5	Context (exp324): frozen DINOv2-base dense tokens, anchored into 5 body parts by
     6	pose keypoints, matched cross-image only over mutually-visible parts (part-MaxSim),
     7	showed a RELATIVE gain on heavy-occluded queries (mAP 1.86 vs 0.55 holistic) but
     8	the absolute numbers are tiny. exp324b trains a SMALL projection head to map those
     9	frozen part features into a ReID-discriminative space.
    10	
    11	KEY DESIGN (do NOT change without re-review):
    12	  * DINOv2 is FROZEN, never back-propped. We pre-extract pose-anchored 5-part
    13	    features (5 x 768d + 5 visibility bools per image) and CACHE them. Every train
    14	    step operates on cached features -> NO DINO forward in the loop -> fast.
    15	  * Head = ONE shared Linear 768->512 (all 5 parts use the SAME Linear) + BNNeck.
    16	  * Global feature = masked mean over VISIBLE projected part vectors.
    17	  * Loss = ID CrossEntropy (on BNNeck feature) + batch-hard SOFT-MARGIN triplet
    18	    (on pre-BNNeck global feature), weight ID:tri = 1:1. Mirrors repo make_loss /
    19	    TripletLoss (loss/triplet_loss.py) semantics.
    20	  * Sampler = PK: P=16 ids x K=4 imgs = BS 64 (HARD constraint, do not change).
    21	  * Eval = two distmats: (i) global cosine, (ii) projected mutually-visible
    22	    part-MaxSim (same logic as exp324). eval_func inline (Market metric). Reported
    23	    for ALL query and HEAVY-OCC query subset (query visibility_binary.sum() <= 8).
    24	
    25	This script REUSES exp324_dino.py helpers (feature extraction geometry, pose part
    26	pooling, coord scaling, part-MaxSim, eval_func) by importing from the sibling module.
    27	
    28	DRY-RUN: `--dry_run` trains only --dry_steps (default 5) optimizer steps, prints
    29	per-step total/ID/triplet loss, then exits WITHOUT full training or eval. This is
    30	the path used for code-search verification before the gated full run.
    31	"""
    32	import os
    33	import sys
    34	import time
    35	import argparse
    36	import numpy as np
    37	import torch
    38	import torch.nn as nn
    39	import torch.nn.functional as F
    40	from PIL import Image
    41	
    42	ROOT = '/root/work/SOLIDER-REID'
    43	sys.path.insert(0, ROOT)
    44	sys.path.insert(0, os.path.join(ROOT, 'scripts'))
    45	
    46	# Reuse exp324 helpers verbatim (geometry, pose pooling, coord scaling,
    47	# part-MaxSim, eval_func). exp324_dino.py is pure numpy/torch at import time.
    48	import exp324_dino as e324
    49	from exp324_dino import (
    50	    GRID_W, GRID_H, HIDDEN, NPARTS, PART_NAMES,
    51	    IMAGENET_MEAN, IMAGENET_STD, IN_W, IN_H,
    52	    HEAVY_OCC_THR,
    53	    eval_func, parse_pid_cam, scale_kp_to_grid, build_part_pose,
    54	)
    55	
    56	DATA = os.path.join(ROOT, 'data/occluded_duke')
    57	TRAIN_DIR = os.path.join(DATA, 'bounding_box_train')
    58	QUERY_DIR = os.path.join(DATA, 'query')
    59	GALLERY_DIR = os.path.join(DATA, 'bounding_box_test')
    60	CACHE_TRAIN = os.path.join(ROOT, 'experiments/exp324b/_cache_train')
    61	CACHE_QG = os.path.join(ROOT, 'experiments/exp324/_cache')  # query/gallery DINO patch cache (reuse)
    62	os.makedirs(CACHE_TRAIN, exist_ok=True)
    63	
    64	
    65	# ============================================================================
    66	# 1. Pose-anchored 5-part feature extraction (cached) for any split.
    67	#    Output per image: parts (5,768) L2-normalized-LATER? NO -- store RAW (un-normalized)
    68	#    768d part means so the head sees the same distribution it will at test time.
    69	#    Also store part_vis (5,) bool, pid, camid.
    70	# ============================================================================
    71	def list_imgs(d):
    72	    return sorted([f for f in os.listdir(d) if f.endswith('.jpg')])
    73	
    74	
    75	def extract_part_features(split, names, img_dir, cache_dir, batch_size=32, limit=None):
    76	    """Extract RAW pose-anchored 5-part features for `split` and cache to disk.
    77	
    78	    Returns dict with:
    79	      parts   : (N,5,768) float32  -- raw part-mean DINO vectors (NOT normalized)
    80	      vis     : (N,5)     bool      -- per-part visibility (pose-derived)
    81	      pids    : (N,)      int64
    82	      camids  : (N,)      int64
    83	    Zero rows where a part is not visible.
    84	    """
    85	    if limit is not None:
    86	        names = names[:limit]
    87	    N = len(names)
    88	    tag = f'{split}_parts_{IN_W}x{IN_H}_n{N}'
    89	    parts_path = os.path.join(cache_dir, f'{tag}.npz')
