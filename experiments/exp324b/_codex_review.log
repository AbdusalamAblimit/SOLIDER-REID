   107	            paths = [os.path.join(img_dir, nm) for nm in bn]
   108	            x = e324.preprocess_batch(paths).cuda(non_blocking=True)
   109	            out = model(x).last_hidden_state            # (B,1+512,768)
   110	            patch = out[:, 1:].reshape(len(bn), GRID_H, GRID_W, HIDDEN)
   111	            patch = patch.float().cpu().numpy()
   112	            for j, nm in enumerate(bn):
   113	                pg = patch[j]                            # (GRID_H,GRID_W,768)
   114	                pose = e324.find_pose(split, nm)
   115	                if pose is None:
