   147	def preprocess_batch(paths):
   148	    """Load + resize + normalize a batch of images. Returns (B,3,IN_H,IN_W) tensor."""
   149	    ims = []
   150	    for p in paths:
   151	        im = Image.open(p).convert('RGB').resize((IN_W, IN_H), Image.BILINEAR)
   152	        arr = torch.from_numpy(np.asarray(im, dtype=np.float32) / 255.0)  # (H,W,3)
   153	        ims.append(arr.permute(2, 0, 1))  # (3,H,W)
   154	    x = torch.stack(ims, dim=0)
   155	    x = (x - IMAGENET_MEAN) / IMAGENET_STD
   156	    return x
