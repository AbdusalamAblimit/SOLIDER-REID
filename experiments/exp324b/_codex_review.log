    39	def eval_func(distmat, q_pids, g_pids, q_camids, g_camids, max_rank=50):
    40	    """Market-1501 metric. Verbatim copy of utils.metrics.eval_func (which we
    41	    cannot import directly: utils/metrics.py top-level imports the model package,
    42	    requiring mmcv/mmengine not present in this system python). Pure numpy."""
    43	    num_q, num_g = distmat.shape
    44	    if num_g < max_rank:
    45	        max_rank = num_g
    46	        print("Note: number of gallery samples is quite small, got {}".format(num_g))
    47	    indices = np.argsort(distmat, axis=1)
    48	    matches = (g_pids[indices] == q_pids[:, np.newaxis]).astype(np.int32)
    49	    all_cmc = []
    50	    all_AP = []
    51	    num_valid_q = 0.
    52	    for q_idx in range(num_q):
    53	        q_pid = q_pids[q_idx]
    54	        q_camid = q_camids[q_idx]
    55	        order = indices[q_idx]
    56	        remove = (g_pids[order] == q_pid) & (g_camids[order] == q_camid)
    57	        keep = np.invert(remove)
    58	        orig_cmc = matches[q_idx][keep]
    59	        if not np.any(orig_cmc):
    60	            continue
    61	        cmc = orig_cmc.cumsum()
    62	        cmc[cmc > 1] = 1
    63	        all_cmc.append(cmc[:max_rank])
    64	        num_valid_q += 1.
    65	        num_rel = orig_cmc.sum()
    66	        tmp_cmc = orig_cmc.cumsum()
    67	        y = np.arange(1, tmp_cmc.shape[0] + 1) * 1.0
    68	        tmp_cmc = tmp_cmc / y
    69	        tmp_cmc = np.asarray(tmp_cmc) * orig_cmc
    70	        AP = tmp_cmc.sum() / num_rel
    71	        all_AP.append(AP)
    72	    assert num_valid_q > 0, "Error: all query identities do not appear in gallery"
    73	    all_cmc = np.asarray(all_cmc).astype(np.float32)
    74	    all_cmc = all_cmc.sum(0) / num_valid_q
    75	    mAP = np.mean(all_AP)
    76	    return all_cmc, mAP
