   173	    cls_all = np.zeros((N, HIDDEN), dtype=np.float16)
   174	    patch_all = np.zeros((N, GRID_H, GRID_W, HIDDEN), dtype=np.float16)
   175	    t0 = time.time()
   176	    for i in range(0, N, batch_size):
   177	        batch_names = names[i:i + batch_size]
   178	        paths = [os.path.join(img_dir, nm) for nm in batch_names]
   179	        x = preprocess_batch(paths).cuda(non_blocking=True)
   180	        out = model(x).last_hidden_state  # (B, 1+512, 768)
   181	        cls = out[:, 0]                     # (B,768)
   182	        patch = out[:, 1:].reshape(len(batch_names), GRID_H, GRID_W, HIDDEN)
   183	        cls_all[i:i + len(batch_names)] = cls.float().cpu().numpy().astype(np.float16)
   184	        patch_all[i:i + len(batch_names)] = patch.float().cpu().numpy().astype(np.float16)
   185	        if (i // batch_size) % 20 == 0:
