   117	                    continue
   118	                kp, vb = pose
   119	                im = Image.open(os.path.join(img_dir, nm))
   120	                W, H = im.size
   121	                kpg = scale_kp_to_grid(kp, W, H)
   122	                pp, pv = build_part_pose(pg, kpg, vb)    # (5,768),(5,)
   123	                parts[i + j] = pp
