   455	        return
   456	
   457	    # ---- query/gallery features for eval ----
   458	    qd = gd = None
   459	    if not args.skip_eval:
   460	        q_names = list_imgs(QUERY_DIR)
   461	        g_names = list_imgs(GALLERY_DIR)
   462	        qd = extract_part_features('query', q_names, QUERY_DIR, CACHE_TRAIN,
   463	                                   batch_size=args.extract_batch)
   464	        gd = extract_part_features('gallery', g_names, GALLERY_DIR, CACHE_TRAIN,
   465	                                   batch_size=args.extract_batch)
   466	        qd['heavy_mask'] = compute_heavy_mask('query', q_names)
   467	        print(f"[eval] heavy-occ queries: {qd['heavy_mask'].sum()}/{len(q_names)}", flush=True)
   468	
   469	    # ---- full training ----
   470	    for epoch in range(1, args.epochs + 1):
   471	        t0 = time.time()
   472	        meters = np.zeros(6)
   473	        nb = 0
   474	        for batch_idx in sampler:
   475	            vals = step(batch_idx)
   476	            meters += np.array(vals)
   477	            nb += 1
   478	        meters /= max(nb, 1)
   479	        print(f'Epoch[{epoch}] loss={meters[0]:.4f} id={meters[1]:.4f} '
   480	              f'tri={meters[2]:.4f} d_ap={meters[3]:.3f} d_an={meters[4]:.3f} '
   481	              f'acc={meters[5]:.3f} time={time.time()-t0:.1f}s', flush=True)
   482	
   483	        if not args.skip_eval and (epoch % args.eval_period == 0 or epoch == args.epochs):
   484	            res = run_eval(head, qd, gd, device)
   485	            def fmt(k):
   486	                if k not in res:
