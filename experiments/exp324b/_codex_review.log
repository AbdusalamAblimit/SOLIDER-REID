   227	# ============================================================================
   228	# 4. PK sampler over cached features. P ids x K imgs = BS. Pure-index sampler:
   229	#    yields lists of dataset indices; the train loop slices cached tensors.
   230	# ============================================================================
   231	class PKSampler:
   232	    """Yields batches of indices: P distinct identities, K images each.
   233	    Identities with < K images are sampled WITH replacement to fill K (standard
   234	    RandomIdentitySampler behaviour). Length = floor(num_imgs / BS) batches/epoch."""
   235	    def __init__(self, pids, P=16, K=4, seed=0):
   236	        self.P, self.K = P, K
   237	        self.bs = P * K
   238	        self.rng = np.random.RandomState(seed)
   239	        self.pid2idx = {}
   240	        for i, p in enumerate(pids):
   241	            self.pid2idx.setdefault(int(p), []).append(i)
   242	        self.pids = list(self.pid2idx.keys())
   243	        self.num_imgs = len(pids)
   244	        # usable identities must have >=1 image (all do). batches per epoch:
   245	        self.num_batches = self.num_imgs // self.bs
   246	
   247	    def __len__(self):
   248	        return self.num_batches
   249	
   250	    def __iter__(self):
   251	        avail = list(self.pids)
   252	        self.rng.shuffle(avail)
   253	        for b in range(self.num_batches):
   254	            if len(avail) < self.P:
   255	                avail = list(self.pids)
   256	                self.rng.shuffle(avail)
   257	            chosen = avail[:self.P]
   258	            avail = avail[self.P:]
   259	            batch = []
   260	            for p in chosen:
   261	                pool = self.pid2idx[p]
   262	                replace = len(pool) < self.K
   263	                sel = self.rng.choice(pool, size=self.K, replace=replace)
   264	                batch.extend(int(x) for x in sel)
   265	            yield batch
   266	
