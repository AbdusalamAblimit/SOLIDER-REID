   193	# 3. Losses. Mirrors loss/triplet_loss.py (batch-hard soft-margin) + plain CE.
   194	# ============================================================================
   195	def euclidean_dist(x, y):
   196	    """Pairwise euclidean distance, same as loss/triplet_loss.euclidean_dist."""
   197	    m, n = x.size(0), y.size(0)
   198	    xx = torch.pow(x, 2).sum(1, keepdim=True).expand(m, n)
   199	    yy = torch.pow(y, 2).sum(1, keepdim=True).expand(n, m).t()
   200	    dist = xx + yy - 2 * torch.matmul(x, y.t())
   201	    dist = dist.clamp(min=1e-12).sqrt()
   202	    return dist
   203	
   204	
   205	def batch_hard_triplet(feat, labels, margin=None, normalize_feature=False):
   206	    """Batch-hard triplet. margin=None -> soft-margin (SoftMarginLoss), matching
   207	    repo TripletLoss default. Returns (loss, mean_dist_ap, mean_dist_an)."""
   208	    if normalize_feature:
   209	        feat = F.normalize(feat, dim=1)
   210	    dist_mat = euclidean_dist(feat, feat)               # (N,N)
   211	    N = dist_mat.size(0)
   212	    is_pos = labels.expand(N, N).eq(labels.expand(N, N).t())
   213	    is_neg = labels.expand(N, N).ne(labels.expand(N, N).t())
   214	    # hardest positive = max pos dist; hardest negative = min neg dist
   215	    dist_ap = (dist_mat * is_pos.float()).max(dim=1)[0]
   216	    # for negatives, set positives to +inf so min picks a true negative
   217	    neg_dist = dist_mat + (~is_neg).float() * 1e12
   218	    dist_an = neg_dist.min(dim=1)[0]
   219	    y = torch.ones_like(dist_an)
   220	    if margin is not None:

