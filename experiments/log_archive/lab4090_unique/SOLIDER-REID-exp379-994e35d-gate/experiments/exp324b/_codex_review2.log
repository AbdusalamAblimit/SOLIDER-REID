   236	# 4. PK sampler over cached features. P ids x K imgs = BS. Pure-index sampler:
   237	#    yields lists of dataset indices; the train loop slices cached tensors.
   238	# ============================================================================
   239	class PKSampler:
   240	    """Yields batches of indices: P distinct identities, K images each.
   241	    Identities with < K images are sampled WITH replacement to fill K (standard
   242	    RandomIdentitySampler behaviour). Length = floor(num_imgs / BS) batches/epoch."""
   243	    def __init__(self, pids, P=16, K=4, seed=0):
   244	        self.P, self.K = P, K
   245	        self.bs = P * K
   246	        self.rng = np.random.RandomState(seed)
   247	        self.pid2idx = {}
   248	        for i, p in enumerate(pids):
   249	            self.pid2idx.setdefault(int(p), []).append(i)
   250	        self.pids = list(self.pid2idx.keys())
   251	        self.num_imgs = len(pids)
   252	        # usable identities must have >=1 image (all do). batches per epoch:
   253	        # guard >=1 so tiny --limit_train (dry-run) still yields a batch.
   254	        self.num_batches = max(1, self.num_imgs // self.bs)
   255	
   256	    def __len__(self):
   257	        return self.num_batches
   258	
   259	    def __iter__(self):
   260	        avail = list(self.pids)
   261	        self.rng.shuffle(avail)
   262	        for b in range(self.num_batches):
   263	            if len(avail) < self.P:
   264	                avail = list(self.pids)
   265	                self.rng.shuffle(avail)
   266	            chosen = avail[:self.P]
   267	            avail = avail[self.P:]
   268	            batch = []
   269	            for p in chosen:
   270	                pool = self.pid2idx[p]
   271	                replace = len(pool) < self.K
   272	                sel = self.rng.choice(pool, size=self.K, replace=replace)
   273	                batch.extend(int(x) for x in sel)
   274	            yield batch
   275	
