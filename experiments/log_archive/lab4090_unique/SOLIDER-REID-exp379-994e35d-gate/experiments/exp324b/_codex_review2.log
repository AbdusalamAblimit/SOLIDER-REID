   213	def batch_hard_triplet(feat, labels, margin=None, normalize_feature=False):
   214	    """Batch-hard triplet. margin=None -> soft-margin (SoftMarginLoss), matching
   215	    repo TripletLoss default. Returns (loss, mean_dist_ap, mean_dist_an)."""
   216	    if normalize_feature:
   217	        feat = F.normalize(feat, dim=1)
   218	    dist_mat = euclidean_dist(feat, feat)               # (N,N)
   219	    N = dist_mat.size(0)
   220	    is_pos = labels.expand(N, N).eq(labels.expand(N, N).t())
   221	    is_neg = labels.expand(N, N).ne(labels.expand(N, N).t())
   222	    # hardest positive = max pos dist; hardest negative = min neg dist
   223	    dist_ap = (dist_mat * is_pos.float()).max(dim=1)[0]
   224	    # for negatives, set positives to +inf so min picks a true negative
   225	    neg_dist = dist_mat + (~is_neg).float() * 1e12
   226	    dist_an = neg_dist.min(dim=1)[0]
   227	    y = torch.ones_like(dist_an)
   228	    if margin is not None:
   229	        loss = F.margin_ranking_loss(dist_an, dist_ap, y, margin=margin)
   230	    else:
   231	        loss = F.soft_margin_loss(dist_an - dist_ap, y)
   232	    return loss, dist_ap.mean(), dist_an.mean()
