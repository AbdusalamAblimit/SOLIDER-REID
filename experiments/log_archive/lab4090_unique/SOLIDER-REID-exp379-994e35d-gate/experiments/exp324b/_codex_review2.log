   201	# 3. Losses. Mirrors loss/triplet_loss.py (batch-hard soft-margin) + plain CE.
   202	# ============================================================================
   203	def euclidean_dist(x, y):
   204	    """Pairwise euclidean distance, same as loss/triplet_loss.euclidean_dist."""
   205	    m, n = x.size(0), y.size(0)
   206	    xx = torch.pow(x, 2).sum(1, keepdim=True).expand(m, n)
   207	    yy = torch.pow(y, 2).sum(1, keepdim=True).expand(n, m).t()
   208	    dist = xx + yy - 2 * torch.matmul(x, y.t())
   209	    dist = dist.clamp(min=1e-12).sqrt()
   210	    return dist
