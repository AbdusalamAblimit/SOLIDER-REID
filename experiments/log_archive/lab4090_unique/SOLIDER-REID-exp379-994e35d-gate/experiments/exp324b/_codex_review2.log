# ============================================================================
# 5. Eval: build distmats on projected features (global cosine + part-MaxSim),
#    score with inline eval_func. Reuses exp324 part_maxsim/holistic distmat math.
# ============================================================================
@torch.no_grad()
def encode_split(head, parts, vis, device, batch=512):
    """Run head over a whole split's cached part features. Returns:
      bn_feats  : (N,512) BNNeck global feat (for cosine retrieval)
      np_parts  : (N,5,512) L2-normalized projected part vectors (for part-MaxSim)
      np_vis    : (N,5) float
    """
    head.eval()
    N = parts.shape[0]
    bn_all = np.zeros((N, head.bottleneck.num_features), dtype=np.float32)
    pp_all = np.zeros((N, NPARTS, head.bottleneck.num_features), dtype=np.float32)
    for i in range(0, N, batch):
        e = min(i + batch, N)
        pt = torch.from_numpy(parts[i:e]).to(device)
        vt = torch.from_numpy(vis[i:e].astype(np.float32)).to(device)
        _, _, bn = head(pt, vt)
        bn_all[i:e] = bn.cpu().numpy()
        pp = head.encode_parts(pt, vt)                   # (b,5,512) normalized
        pp_all[i:e] = pp.cpu().numpy()
    return bn_all, pp_all, vis.astype(np.float32)


def run_eval(head, qd, gd, device):
    """Compute both distmats and eval mAP/R1 on ALL + HEAVY-OCC subsets."""
    q_pids, q_camids = qd['pids'], qd['camids']
    g_pids, g_camids = gd['pids'], gd['camids']

    q_bn, q_pp, q_vis = encode_split(head, qd['parts'], qd['vis'], device)
    g_bn, g_pp, g_vis = encode_split(head, gd['parts'], gd['vis'], device)

    # (i) global cosine distance (exp324 holistic_distmat)
    dm_cos = e324.holistic_distmat(q_bn, g_bn, device=str(device))
    # (ii) mutually-visible part-MaxSim on projected normalized parts
    dm_part = e324.part_maxsim_distmat(q_pp, q_vis > 0, g_pp, g_vis > 0, device=str(device))

    # heavy-occ mask = query visible-part count <= heavy threshold-equivalent.
    # Use pose visibility_binary sum like exp324; here approximate with #visible
    # parts is too coarse, so recompute from pose. We instead reuse cached per-
    # image pose vis-sum if available; else fall back to #visible parts<= (NPARTS scaled).
    heavy_mask = qd.get('heavy_mask')
    if heavy_mask is None:
        # fallback: not enough info -> all-query only
        heavy_mask = np.zeros(len(q_pids), dtype=bool)

    def _ev(dm, mask=None):
        if mask is not None and mask.any():
            cmc, mAP = eval_func(dm[mask].astype(np.float32), q_pids[mask],
                                 g_pids, q_camids[mask], g_camids)
        else:
            cmc, mAP = eval_func(dm.astype(np.float32), q_pids, g_pids,
                                 q_camids, g_camids)
        return mAP, cmc[0], cmc[4], cmc[9]

    out = {}
    out['cos_all'] = _ev(dm_cos)
    out['part_all'] = _ev(dm_part)
    if heavy_mask.any():
        out['cos_heavy'] = _ev(dm_cos, heavy_mask)
        out['part_heavy'] = _ev(dm_part, heavy_mask)
    return out


def compute_heavy_mask(split, names):
    """query heavy-occ mask: pose visibility_binary.sum() <= HEAVY_OCC_THR. p0."""
    m = np.zeros(len(names), dtype=bool)
    for i, nm in enumerate(names):
        pose = e324.find_pose(split, nm)
        s = int(pose[1].sum()) if pose is not None else 17
        m[i] = s <= HEAVY_OCC_THR
    return m


# ============================================================================
# 6. Training loop
# ============================================================================
def relabel(pids):
    """Map raw pids -> contiguous [0..C-1] for the classifier. Returns (labels, C)."""
    uniq = sorted(set(int(p) for p in pids))
    pid2lab = {p: i for i, p in enumerate(uniq)}
    labels = np.array([pid2lab[int(p)] for p in pids], dtype=np.int64)
    return labels, len(uniq)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--epochs', type=int, default=60)
    ap.add_argument('--P', type=int, default=16)
    ap.add_argument('--K', type=int, default=4)
    ap.add_argument('--embed_dim', type=int, default=512)
    ap.add_argument('--lr', type=float, default=3.5e-4)
    ap.add_argument('--weight_decay', type=float, default=5e-4)
    ap.add_argument('--optim', choices=['adam', 'sgd'], default='adam')
    ap.add_argument('--id_weight', type=float, default=1.0)
    ap.add_argument('--tri_weight', type=float, default=1.0)
    ap.add_argument('--part_weight', type=float, default=0.5,
                    help='part-level ID loss weight (0 = global-only ablation arm)')
    ap.add_argument('--margin', type=float, default=None,
                    help='triplet margin; None -> soft-margin (default)')
    ap.add_argument('--seed', type=int, default=1234)
    ap.add_argument('--extract_batch', type=int, default=32)
    ap.add_argument('--eval_period', type=int, default=10)
    ap.add_argument('--ckpt_period', type=int, default=20)
    ap.add_argument('--output_dir', type=str,
                    default=os.path.join(ROOT, 'log/occluded_duke/exp324b'))
    # dry-run
    ap.add_argument('--dry_run', action='store_true',
                    help='train only --dry_steps steps, print losses, then exit')
    ap.add_argument('--dry_steps', type=int, default=5)
    ap.add_argument('--limit_train', type=int, default=None,
                    help='limit #train images (for fast dry-run extraction)')
    ap.add_argument('--skip_eval', action='store_true')
    args = ap.parse_args()

    torch.manual_seed(args.seed)
    np.random.seed(args.seed)
    device = torch.device('cuda')
    os.makedirs(args.output_dir, exist_ok=True)
    bs = args.P * args.K
    print(f'[cfg] BS={bs} (P={args.P} K={args.K}) embed={args.embed_dim} '
          f'lr={args.lr} optim={args.optim} id_w={args.id_weight} tri_w={args.tri_weight} '
          f'margin={args.margin} dry_run={args.dry_run}', flush=True)

    # ---- 1. extract / load TRAIN part features ----
    train_names = list_imgs(TRAIN_DIR)
    if args.limit_train:
        train_names = train_names[:args.limit_train]
    td = extract_part_features('train', train_names, TRAIN_DIR, CACHE_TRAIN,
                               batch_size=args.extract_batch, limit=args.limit_train)
    labels, num_classes = relabel(td['pids'])
    td['labels'] = labels
    print(f'[train] imgs={len(train_names)} classes={num_classes}', flush=True)

    # ---- 2. model + optimizer ----
    head = PartHead(in_dim=HIDDEN, embed_dim=args.embed_dim,
                    num_classes=num_classes).to(device)
    n_params = sum(p.numel() for p in head.parameters() if p.requires_grad)
    print(f'[model] trainable params = {n_params:,}', flush=True)

    # Exclude BN (1-D) params from weight decay (repo convention: WD on BN gamma
    # hurts). Split params into decay / no-decay groups.
    decay, no_decay = [], []
    for n, p in head.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 else decay).append(p)
    pgroups = [{'params': decay, 'weight_decay': args.weight_decay},
               {'params': no_decay, 'weight_decay': 0.0}]
    if args.optim == 'adam':
        optimizer = torch.optim.Adam(pgroups, lr=args.lr)
    else:
        optimizer = torch.optim.SGD(pgroups, lr=args.lr, momentum=0.9)
    # Cosine LR decay over epochs (the script had none; 60 epochs needs decay).
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=args.epochs)
    ce = nn.CrossEntropyLoss()

    sampler = PKSampler(td['pids'], P=args.P, K=args.K, seed=args.seed)
    parts_t = td['parts']
    vis_t = td['vis']
    lab_t = td['labels']

    def step(batch_idx):
        idx = np.asarray(batch_idx, dtype=np.int64)
        pt = torch.from_numpy(parts_t[idx]).to(device)              # (BS,5,768)
        vt = torch.from_numpy(vis_t[idx].astype(np.float32)).to(device)  # (BS,5)
        yt = torch.from_numpy(lab_t[idx]).to(device)                # (BS,)
        head.train()
        cls, glob, bn = head(pt, vt)
        id_loss = ce(cls, yt)
        tri_loss, dap, dan = batch_hard_triplet(glob, yt, margin=args.margin)
        # part-level ID supervision over VISIBLE parts (aligns training with the
        # per-part part-MaxSim test space). proj parts -> shared part classifier.
        if args.part_weight > 0:
            proj = head.project_parts(pt)                 # (BS,5,512)
            B, P, _ = proj.shape
            plogits = head.part_classifier(proj.reshape(B * P, -1))   # (BS*5,C)
            ylab = yt.unsqueeze(1).expand(B, P).reshape(B * P)        # (BS*5,)
            vmask = vt.reshape(B * P) > 0                             # visible parts only
            part_loss = ce(plogits[vmask], ylab[vmask]) if vmask.any() \
                else torch.zeros((), device=pt.device)
        else:
            part_loss = torch.zeros((), device=pt.device)
        loss = (args.id_weight * id_loss + args.tri_weight * tri_loss
                + args.part_weight * part_loss)
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        with torch.no_grad():
            acc = (cls.argmax(dim=1) == yt).float().mean().item()
        return (loss.item(), id_loss.item(), tri_loss.item(), part_loss.item(),
                dap.item(), dan.item(), acc)

    # ---- DRY RUN: few steps, print, exit ----
    if args.dry_run:
        print(f'\n[DRY-RUN] training {args.dry_steps} steps then exiting', flush=True)
        it = iter(sampler)
        for s in range(args.dry_steps):
            try:
                batch_idx = next(it)
            except StopIteration:
                it = iter(sampler)
                batch_idx = next(it)
            loss, idl, tril, prtl, dap, dan, acc = step(batch_idx)
            uniq_ids = len(set(int(lab_t[i]) for i in batch_idx))
            print(f'[dry step {s+1}/{args.dry_steps}] bs={len(batch_idx)} '
                  f'uniq_ids={uniq_ids} | total={loss:.4f} id={idl:.4f} '
                  f'tri={tril:.4f} part={prtl:.4f} | d_ap={dap:.3f} d_an={dan:.3f} '
                  f'acc={acc:.3f}', flush=True)
        print('[DRY-RUN] done. Not running full training/eval.', flush=True)
        return

    # ---- query/gallery features for eval ----
    qd = gd = None
    if not args.skip_eval:
        q_names = list_imgs(QUERY_DIR)
        g_names = list_imgs(GALLERY_DIR)
        qd = extract_part_features('query', q_names, QUERY_DIR, CACHE_TRAIN,
                                   batch_size=args.extract_batch)
        gd = extract_part_features('gallery', g_names, GALLERY_DIR, CACHE_TRAIN,
                                   batch_size=args.extract_batch)
        qd['heavy_mask'] = compute_heavy_mask('query', q_names)
        print(f"[eval] heavy-occ queries: {qd['heavy_mask'].sum()}/{len(q_names)}", flush=True)

    # ---- full training ----
    for epoch in range(1, args.epochs + 1):
        t0 = time.time()
        meters = np.zeros(7)
        nb = 0
        for batch_idx in sampler:
            vals = step(batch_idx)
            meters += np.array(vals)
            nb += 1
        meters /= max(nb, 1)
        print(f'Epoch[{epoch}] loss={meters[0]:.4f} id={meters[1]:.4f} '
              f'tri={meters[2]:.4f} part={meters[3]:.4f} d_ap={meters[4]:.3f} '
              f'd_an={meters[5]:.3f} acc={meters[6]:.3f} '
              f'lr={optimizer.param_groups[0]["lr"]:.2e} time={time.time()-t0:.1f}s',
              flush=True)
        scheduler.step()

        if not args.skip_eval and (epoch % args.eval_period == 0 or epoch == args.epochs):
            res = run_eval(head, qd, gd, device)
            def fmt(k):
                if k not in res:
                    return 'n/a'
                m, r1, r5, r10 = res[k]
                return f'mAP={m*100:.2f} R1={r1*100:.2f} R5={r5*100:.2f} R10={r10*100:.2f}'
            print(f'  [eval e{epoch}] cos  ALL  : {fmt("cos_all")}', flush=True)
            print(f'  [eval e{epoch}] part ALL  : {fmt("part_all")}', flush=True)
            print(f'  [eval e{epoch}] cos  HEAVY: {fmt("cos_heavy")}', flush=True)
            print(f'  [eval e{epoch}] part HEAVY: {fmt("part_heavy")}', flush=True)

        if epoch % args.ckpt_period == 0 or epoch == args.epochs:
            p = os.path.join(args.output_dir, f'head_{epoch}.pth')
            torch.save(head.state_dict(), p)
            print(f'  [ckpt] saved {p}', flush=True)

    print('[done] full training complete', flush=True)


if __name__ == '__main__':
    main()

