   303	def run_eval(head, qd, gd, device):
   304	    """Compute both distmats and eval mAP/R1 on ALL + HEAVY-OCC subsets."""
   305	    q_pids, q_camids = qd['pids'], qd['camids']
   306	    g_pids, g_camids = gd['pids'], gd['camids']
   307	
   308	    q_bn, q_pp, q_vis = encode_split(head, qd['parts'], qd['vis'], device)
   309	    g_bn, g_pp, g_vis = encode_split(head, gd['parts'], gd['vis'], device)
   310	
   311	    # (i) global cosine distance (exp324 holistic_distmat)
   312	    dm_cos = e324.holistic_distmat(q_bn, g_bn, device=str(device))
   313	    # (ii) mutually-visible part-MaxSim on projected normalized parts
   314	    dm_part = e324.part_maxsim_distmat(q_pp, q_vis > 0, g_pp, g_vis > 0, device=str(device))
   315	
   316	    # heavy-occ mask = query visible-part count <= heavy threshold-equivalent.
   317	    # Use pose visibility_binary sum like exp324; here approximate with #visible
   318	    # parts is too coarse, so recompute from pose. We instead reuse cached per-
   319	    # image pose vis-sum if available; else fall back to #visible parts<= (NPARTS scaled).
   320	    heavy_mask = qd.get('heavy_mask')
   321	    if heavy_mask is None:
   322	        # fallback: not enough info -> all-query only
   323	        heavy_mask = np.zeros(len(q_pids), dtype=bool)
   324	
   325	    def _ev(dm, mask=None):
   326	        if mask is not None and mask.any():
   327	            cmc, mAP = eval_func(dm[mask].astype(np.float32), q_pids[mask],
   328	                                 g_pids, q_camids[mask], g_camids)
   329	        else:
   330	            cmc, mAP = eval_func(dm.astype(np.float32), q_pids, g_pids,
   331	                                 q_camids, g_camids)
   332	        return mAP, cmc[0], cmc[4], cmc[9]
   333	
   334	    out = {}
   335	    out['cos_all'] = _ev(dm_cos)
   336	    out['part_all'] = _ev(dm_part)
   337	    if heavy_mask.any():
   338	        out['cos_heavy'] = _ev(dm_cos, heavy_mask)
   339	        out['part_heavy'] = _ev(dm_part, heavy_mask)
   340	    return out

