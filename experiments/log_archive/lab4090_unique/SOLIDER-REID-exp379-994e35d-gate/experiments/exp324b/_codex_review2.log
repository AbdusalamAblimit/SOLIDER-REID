#!/usr/bin/env python3
"""exp324: Training-free DINOv2 dense-correspondence + pose-anchored part matching
for occluded person ReID on Occluded-Duke.

Hypothesis: frozen DINOv2-base dense patch features, anchored into 5 body parts by
pose keypoints, and matched cross-image only over parts that are visible in BOTH
images (part-MaxSim), give a RELATIVE gain over a holistic (CLS / mean-pool) baseline
on heavily-occluded queries. A uniform-grid variant (5 horizontal bands, no pose)
isolates the contribution of pose anchoring.

Pure inference / eval. No training. Does not touch model/ core code.

Pipeline:
  1. Extract DINOv2 patch tokens for all query+gallery imgs (resize 224W x 448H,
     patch=14 -> 16 cols x 32 rows = 512 patch tokens + 1 CLS). Cache to disk.
  2. Build three representations:
       (a) holistic   : CLS token (also report mean-pool patches)
       (b) part_pose  : 5 pose-anchored part vectors + per-part visibility
       (c) part_grid  : 5 horizontal-band part vectors (uniform, no pose)
  3. Score:
       (a) cosine distance on holistic vector
       (b)/(c) part-MaxSim: only common-visible parts, per-part cosine, averaged
  4. eval_func (utils.metrics) -> mAP/R1, two slices: all-query, heavy-occ (vis<=8).

Coordinate scaling: keypoints are already in ORIGINAL JPG PIXEL space (verified
exp323). Map (x,y) -> grid (col = x/W * GRID_W, row = y/H * GRID_H). Pool patch
tokens within Chebyshev radius POOL_RADIUS of the mapped cell(s).
"""
import os, sys, glob, time, argparse
import numpy as np
import torch
import torch.nn.functional as F
from PIL import Image

ROOT = '/root/work/SOLIDER-REID'
sys.path.insert(0, ROOT)


def eval_func(distmat, q_pids, g_pids, q_camids, g_camids, max_rank=50):
    """Market-1501 metric. Verbatim copy of utils.metrics.eval_func (which we
    cannot import directly: utils/metrics.py top-level imports the model package,
    requiring mmcv/mmengine not present in this system python). Pure numpy."""
    num_q, num_g = distmat.shape
    if num_g < max_rank:
        max_rank = num_g
        print("Note: number of gallery samples is quite small, got {}".format(num_g))
    indices = np.argsort(distmat, axis=1)
    matches = (g_pids[indices] == q_pids[:, np.newaxis]).astype(np.int32)
    all_cmc = []
    all_AP = []
    num_valid_q = 0.
    for q_idx in range(num_q):
        q_pid = q_pids[q_idx]
        q_camid = q_camids[q_idx]
        order = indices[q_idx]
        remove = (g_pids[order] == q_pid) & (g_camids[order] == q_camid)
        keep = np.invert(remove)
        orig_cmc = matches[q_idx][keep]
        if not np.any(orig_cmc):
            continue
        cmc = orig_cmc.cumsum()
        cmc[cmc > 1] = 1
        all_cmc.append(cmc[:max_rank])
        num_valid_q += 1.
        num_rel = orig_cmc.sum()
        tmp_cmc = orig_cmc.cumsum()
        y = np.arange(1, tmp_cmc.shape[0] + 1) * 1.0
        tmp_cmc = tmp_cmc / y
        tmp_cmc = np.asarray(tmp_cmc) * orig_cmc
        AP = tmp_cmc.sum() / num_rel
        all_AP.append(AP)
    assert num_valid_q > 0, "Error: all query identities do not appear in gallery"
    all_cmc = np.asarray(all_cmc).astype(np.float32)
    all_cmc = all_cmc.sum(0) / num_valid_q
    mAP = np.mean(all_AP)
    return all_cmc, mAP

DATA = os.path.join(ROOT, 'data/occluded_duke')
QUERY_DIR = os.path.join(DATA, 'query')
GALLERY_DIR = os.path.join(DATA, 'bounding_box_test')
POSE_DIR = os.path.join(DATA, 'pose_data')
CACHE_DIR = os.path.join(ROOT, 'experiments/exp324/_cache')
os.makedirs(CACHE_DIR, exist_ok=True)

# ---- DINOv2 input / grid geometry ----
IN_W, IN_H = 224, 448          # resize target (W,H), keeps ~1:2 person aspect
PATCH = 14
GRID_W, GRID_H = IN_W // PATCH, IN_H // PATCH   # 16 cols, 32 rows
HIDDEN = 768

# ---- COCO-17 -> 5 parts ----
PART_GROUPS = {
    'head':  [0, 1, 2, 3, 4],
    'torso': [5, 6, 11, 12],
    'arms':  [7, 8, 9, 10],
    'legs':  [13, 14],
    'feet':  [15, 16],
}
PART_NAMES = list(PART_GROUPS.keys())  # fixed order
NPARTS = len(PART_NAMES)
POOL_RADIUS = 1                # Chebyshev radius around each kp cell (3x3 window)
HEAVY_OCC_THR = 8             # query is "heavy-occluded" if visibility_binary.sum() <= 8

IMAGENET_MEAN = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1)
IMAGENET_STD = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1)


# ----------------------------------------------------------------------------
# data listing
# ----------------------------------------------------------------------------
def list_imgs(d):
    return sorted([f for f in os.listdir(d) if f.endswith('.jpg')])


def parse_pid_cam(name):
    # name like 0019_c1_f0051230.jpg
    pid = int(name.split('_')[0])
    cam = int(name.split('_')[1][1:])  # after 'c'
    return pid, cam


def find_pose(split, imgname):
    """Pick the PRIMARY person detection (p0). For all-image extraction we have no
    target visibility to match against, so use highest-confidence primary (p0),
    same convention exp323 uses for gallery. Returns (kp(17,2), vb(17,)) or None."""
    base = imgname[:-4] if imgname.endswith('.jpg') else imgname
    pose_dir = os.path.join(POSE_DIR, split)
    cands = sorted(glob.glob(os.path.join(pose_dir, base + '_p*.npz')))
    if not cands:
        return None
    d = np.load(cands[0])  # p0 = primary
    return d['keypoints'].astype(np.float32), d['visibility_binary'].astype(bool)


# ----------------------------------------------------------------------------
# DINOv2 feature extraction (cached)
# ----------------------------------------------------------------------------
def load_model():
    os.environ.setdefault('HF_ENDPOINT', 'https://hf-mirror.com')
    from transformers import AutoModel
    m = AutoModel.from_pretrained('facebook/dinov2-base').eval().cuda()
    for p in m.parameters():
        p.requires_grad_(False)
    return m


def preprocess_batch(paths):
    """Load + resize + normalize a batch of images. Returns (B,3,IN_H,IN_W) tensor."""
    ims = []
    for p in paths:
        im = Image.open(p).convert('RGB').resize((IN_W, IN_H), Image.BILINEAR)
        arr = torch.from_numpy(np.asarray(im, dtype=np.float32) / 255.0)  # (H,W,3)
        ims.append(arr.permute(2, 0, 1))  # (3,H,W)
    x = torch.stack(ims, dim=0)
    x = (x - IMAGENET_MEAN) / IMAGENET_STD
    return x


@torch.no_grad()
def extract_split(model, split, names, img_dir, batch_size=32, limit=None):
    """Extract CLS (B,768) + patch grid (B,GRID_H,GRID_W,768) for a split.
    Cache to disk. Returns (cls (N,768) float16, patch (N,GRID_H,GRID_W,768) float16)."""
    if limit is not None:
        names = names[:limit]
    tag = f'{split}_{IN_W}x{IN_H}_n{len(names)}'
    cls_path = os.path.join(CACHE_DIR, f'cls_{tag}.npy')
    patch_path = os.path.join(CACHE_DIR, f'patch_{tag}.npy')
    if os.path.exists(cls_path) and os.path.exists(patch_path):
        print(f'[cache] load {tag}')
        return (np.load(cls_path), np.load(patch_path, mmap_mode='r'))

    N = len(names)
    cls_all = np.zeros((N, HIDDEN), dtype=np.float16)
    patch_all = np.zeros((N, GRID_H, GRID_W, HIDDEN), dtype=np.float16)
    t0 = time.time()
    for i in range(0, N, batch_size):
        batch_names = names[i:i + batch_size]
        paths = [os.path.join(img_dir, nm) for nm in batch_names]
        x = preprocess_batch(paths).cuda(non_blocking=True)
        out = model(x).last_hidden_state  # (B, 1+512, 768)
        cls = out[:, 0]                     # (B,768)
        patch = out[:, 1:].reshape(len(batch_names), GRID_H, GRID_W, HIDDEN)
        cls_all[i:i + len(batch_names)] = cls.float().cpu().numpy().astype(np.float16)
        patch_all[i:i + len(batch_names)] = patch.float().cpu().numpy().astype(np.float16)
        if (i // batch_size) % 20 == 0:
            el = time.time() - t0
            print(f'  [{split}] {i + len(batch_names)}/{N}  {el:.1f}s', flush=True)
    np.save(cls_path, cls_all)
    np.save(patch_path, patch_all)
    print(f'[extract] {split} done {time.time() - t0:.1f}s -> {cls_path}')
    return cls_all, patch_all


# ----------------------------------------------------------------------------
# representation building
# ----------------------------------------------------------------------------
def build_part_pose(patch_grid, kp, vb):
    """Pose-anchored 5-part vectors from one image's patch grid.
    patch_grid: (GRID_H,GRID_W,HIDDEN) float. kp:(17,2) orig pixel, vb:(17,) bool.
    img W,H needed to scale -> passed via globals on caller (we pass kp already
    scaled). Returns (parts (5,HIDDEN) float32, part_vis (5,) bool).

    NOTE: kp passed here must ALREADY be scaled to grid coords (col,row)."""
    parts = np.zeros((NPARTS, HIDDEN), dtype=np.float32)
    part_vis = np.zeros(NPARTS, dtype=bool)
    for pi, pname in enumerate(PART_NAMES):
        cells = set()
        for ki in PART_GROUPS[pname]:
            if not vb[ki]:
                continue
            cx, cy = kp[ki, 0], kp[ki, 1]
            # (0,0) is the missing sentinel; skip
            if cx <= 0 and cy <= 0:
                continue
            col = int(round(cx))
            row = int(round(cy))
            for dr in range(-POOL_RADIUS, POOL_RADIUS + 1):
                for dc in range(-POOL_RADIUS, POOL_RADIUS + 1):
                    r, c = row + dr, col + dc
                    if 0 <= r < GRID_H and 0 <= c < GRID_W:
                        cells.add((r, c))
        if cells:
            rs = np.fromiter((c[0] for c in cells), dtype=np.int64)
            cs = np.fromiter((c[1] for c in cells), dtype=np.int64)
            parts[pi] = patch_grid[rs, cs].mean(axis=0)
            part_vis[pi] = True
    return parts, part_vis


def build_part_grid(patch_grid):
    """Uniform 5-band vectors (no pose). Split GRID_H rows into 5 contiguous bands,
    mean-pool each band over all columns. All bands marked visible.
    Returns (parts (5,HIDDEN) float32, part_vis (5,) all True)."""
    parts = np.zeros((NPARTS, HIDDEN), dtype=np.float32)
    bounds = np.linspace(0, GRID_H, NPARTS + 1).astype(int)
    for pi in range(NPARTS):
        r0, r1 = bounds[pi], bounds[pi + 1]
        if r1 <= r0:
            r1 = r0 + 1
        parts[pi] = patch_grid[r0:r1].reshape(-1, HIDDEN).mean(axis=0)
    return parts, np.ones(NPARTS, dtype=bool)


def scale_kp_to_grid(kp, W, H):
    """Scale keypoints from original pixel space to grid (col,row) space."""
    out = kp.copy()
    out[:, 0] = kp[:, 0] / max(W, 1) * GRID_W
    out[:, 1] = kp[:, 1] / max(H, 1) * GRID_H
    return out


# ----------------------------------------------------------------------------
# part-MaxSim distance over common-visible parts
# ----------------------------------------------------------------------------
def part_maxsim_distmat(q_parts, q_vis, g_parts, g_vis, device='cuda'):
    """q_parts:(Q,5,D) normalized, q_vis:(Q,5) bool. Same for g.
    For each (q,g) pair: per-part cosine sim only for parts visible in BOTH,
    averaged over common-visible parts -> sim. distance = 1 - sim.
    If no common part -> max distance (2.0).
    Returns distmat (Q,G) numpy."""

