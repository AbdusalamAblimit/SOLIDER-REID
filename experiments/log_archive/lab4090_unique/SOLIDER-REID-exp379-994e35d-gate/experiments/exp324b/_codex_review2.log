#!/usr/bin/env python3
"""exp324b: Train a LIGHTWEIGHT projection head on top of FROZEN DINOv2-base
pose-anchored 5-part features for occluded person ReID (Occluded-Duke).

Context (exp324): frozen DINOv2-base dense tokens, anchored into 5 body parts by
pose keypoints, matched cross-image only over mutually-visible parts (part-MaxSim),
showed a RELATIVE gain on heavy-occluded queries (mAP 1.86 vs 0.55 holistic) but
the absolute numbers are tiny. exp324b trains a SMALL projection head to map those
frozen part features into a ReID-discriminative space.

KEY DESIGN (do NOT change without re-review):
  * DINOv2 is FROZEN, never back-propped. We pre-extract pose-anchored 5-part
    features (5 x 768d + 5 visibility bools per image) and CACHE them. Every train
    step operates on cached features -> NO DINO forward in the loop -> fast.
  * Head = ONE shared Linear 768->512 (all 5 parts use the SAME Linear) + BNNeck.
  * Global feature = masked mean over VISIBLE projected part vectors.
  * Loss = ID CrossEntropy (on BNNeck feature) + batch-hard SOFT-MARGIN triplet
    (on pre-BNNeck global feature), weight ID:tri = 1:1. Mirrors repo make_loss /
    TripletLoss (loss/triplet_loss.py) semantics.
  * Sampler = PK: P=16 ids x K=4 imgs = BS 64 (HARD constraint, do not change).
  * Eval = two distmats: (i) global cosine, (ii) projected mutually-visible
    part-MaxSim (same logic as exp324). eval_func inline (Market metric). Reported
    for ALL query and HEAVY-OCC query subset (query visibility_binary.sum() <= 8).

This script REUSES exp324_dino.py helpers (feature extraction geometry, pose part
pooling, coord scaling, part-MaxSim, eval_func) by importing from the sibling module.

DRY-RUN: `--dry_run` trains only --dry_steps (default 5) optimizer steps, prints
per-step total/ID/triplet loss, then exits WITHOUT full training or eval. This is
the path used for code-search verification before the gated full run.
"""
import os
import sys
import time
import argparse
import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
from PIL import Image

ROOT = '/root/work/SOLIDER-REID'
sys.path.insert(0, ROOT)
sys.path.insert(0, os.path.join(ROOT, 'scripts'))

# Reuse exp324 helpers verbatim (geometry, pose pooling, coord scaling,
# part-MaxSim, eval_func). exp324_dino.py is pure numpy/torch at import time.
import exp324_dino as e324
from exp324_dino import (
    GRID_W, GRID_H, HIDDEN, NPARTS, PART_NAMES,
    IMAGENET_MEAN, IMAGENET_STD, IN_W, IN_H,
    HEAVY_OCC_THR,
    eval_func, parse_pid_cam, scale_kp_to_grid, build_part_pose,
)

DATA = os.path.join(ROOT, 'data/occluded_duke')
TRAIN_DIR = os.path.join(DATA, 'bounding_box_train')
QUERY_DIR = os.path.join(DATA, 'query')
GALLERY_DIR = os.path.join(DATA, 'bounding_box_test')
CACHE_TRAIN = os.path.join(ROOT, 'experiments/exp324b/_cache_train')
# train/query/gallery pose-anchored part features all cached here, extracted
# through the SAME DINO pipeline (internally consistent; exp324's cache holds the
# raw patch grid, not pooled parts, so it can't be reused directly).
os.makedirs(CACHE_TRAIN, exist_ok=True)


# ============================================================================
# 1. Pose-anchored 5-part feature extraction (cached) for any split.
#    Output per image: parts (5,768) L2-normalized-LATER? NO -- store RAW (un-normalized)
#    768d part means so the head sees the same distribution it will at test time.
#    Also store part_vis (5,) bool, pid, camid.
# ============================================================================
def list_imgs(d):
    return sorted([f for f in os.listdir(d) if f.endswith('.jpg')])


def extract_part_features(split, names, img_dir, cache_dir, batch_size=32, limit=None):
    """Extract RAW pose-anchored 5-part features for `split` and cache to disk.

    Returns dict with:
      parts   : (N,5,768) float32  -- raw part-mean DINO vectors (NOT normalized)
      vis     : (N,5)     bool      -- per-part visibility (pose-derived)
      pids    : (N,)      int64
      camids  : (N,)      int64
    Zero rows where a part is not visible.
    """
    if limit is not None:
        names = names[:limit]
    N = len(names)
    tag = f'{split}_parts_{IN_W}x{IN_H}_n{N}'
    parts_path = os.path.join(cache_dir, f'{tag}.npz')
    if os.path.exists(parts_path):
        print(f'[cache] load {parts_path}', flush=True)
        d = np.load(parts_path)
        return {'parts': d['parts'], 'vis': d['vis'],
                'pids': d['pids'], 'camids': d['camids'], 'names': names}

    pids = np.array([parse_pid_cam(n)[0] for n in names], dtype=np.int64)
    camids = np.array([parse_pid_cam(n)[1] for n in names], dtype=np.int64)
    parts = np.zeros((N, NPARTS, HIDDEN), dtype=np.float32)
    vis = np.zeros((N, NPARTS), dtype=bool)

    model = e324.load_model()
    n_nopose = 0
    t0 = time.time()
    with torch.no_grad():
        for i in range(0, N, batch_size):
            bn = names[i:i + batch_size]
            paths = [os.path.join(img_dir, nm) for nm in bn]
            x = e324.preprocess_batch(paths).cuda(non_blocking=True)
            out = model(x).last_hidden_state            # (B,1+512,768)
            patch = out[:, 1:].reshape(len(bn), GRID_H, GRID_W, HIDDEN)
            patch = patch.float().cpu().numpy()
            for j, nm in enumerate(bn):
                pg = patch[j]                            # (GRID_H,GRID_W,768)
                pose = e324.find_pose(split, nm)
                if pose is None:
                    n_nopose += 1
                    continue
                kp, vb = pose
                im = Image.open(os.path.join(img_dir, nm))
                W, H = im.size
                kpg = scale_kp_to_grid(kp, W, H)
                pp, pv = build_part_pose(pg, kpg, vb)    # (5,768),(5,)
                parts[i + j] = pp
                vis[i + j] = pv
            if (i // batch_size) % 20 == 0:
                print(f'  [{split}] {i + len(bn)}/{N}  {time.time() - t0:.1f}s', flush=True)
    print(f'[extract] {split} parts done {time.time() - t0:.1f}s  no-pose={n_nopose}/{N}', flush=True)
    np.savez(parts_path, parts=parts, vis=vis, pids=pids, camids=camids)
    print(f'[cache] saved {parts_path}', flush=True)
    return {'parts': parts, 'vis': vis, 'pids': pids, 'camids': camids, 'names': names}


# ============================================================================
# 2. Lightweight head: shared Linear 768->512 (all parts share it) + BNNeck +
#    ID classifier. Global feat = masked mean over visible projected parts.
# ============================================================================
class PartHead(nn.Module):
    def __init__(self, in_dim=HIDDEN, embed_dim=512, num_classes=0):
        super().__init__()
        # ONE shared linear applied to every part vector independently.
        self.proj = nn.Linear(in_dim, embed_dim, bias=False)
        # BNNeck on the global (masked-mean) feature.
        self.bottleneck = nn.BatchNorm1d(embed_dim)
        self.bottleneck.bias.requires_grad_(False)   # standard BNNeck: no bias
        self.classifier = nn.Linear(embed_dim, num_classes, bias=False)
        # Part-level classifier: shared across the 5 parts, supervises each
        # projected part vector directly (the space part-MaxSim is tested in),
        # fixing the train/test mismatch flagged in review (global-only -> part
        # vectors stay weakly aligned). Ablatable via --part_weight (0 = off).
        self.part_classifier = nn.Linear(embed_dim, num_classes, bias=False)
        self._init()

    def _init(self):
        nn.init.kaiming_normal_(self.proj.weight, mode='fan_out')
        nn.init.constant_(self.bottleneck.weight, 1.0)
        nn.init.constant_(self.bottleneck.bias, 0.0)
        nn.init.normal_(self.classifier.weight, std=0.001)
        nn.init.normal_(self.part_classifier.weight, std=0.001)

    def project_parts(self, parts):
        """parts: (B,5,768) -> projected (B,5,512). Shared linear over part axis."""
        B, P, D = parts.shape
        flat = parts.reshape(B * P, D)
        proj = self.proj(flat).reshape(B, P, -1)        # (B,5,512)
        return proj

    @staticmethod
    def masked_mean(proj, vis):
        """proj:(B,5,512), vis:(B,5) bool/float -> global (B,512) masked mean over
        VISIBLE parts. Images with zero visible parts fall back to a plain mean
        (denominator clamped to 1) to avoid NaN; such images are rare."""
        v = vis.float().unsqueeze(-1)                   # (B,5,1)
        s = (proj * v).sum(dim=1)                        # (B,512)
        cnt = v.sum(dim=1).clamp(min=1.0)                # (B,1)
        return s / cnt

    def forward(self, parts, vis):
        """Returns (cls_score, global_feat_pre_bn, bn_feat).
        cls_score: (B,num_classes) logits  (training).
        global_feat_pre_bn: (B,512) for triplet loss (un-normalized).
        bn_feat: (B,512) after BNNeck (for ID loss in training, for retrieval at test)."""
        proj = self.project_parts(parts)                # (B,5,512)
        glob = self.masked_mean(proj, vis)              # (B,512)
        bn = self.bottleneck(glob)                       # (B,512)
        cls = self.classifier(bn)                        # (B,num_classes)
        return cls, glob, bn

    @torch.no_grad()
    def encode_parts(self, parts, vis):
        """For part-MaxSim eval: return L2-normalized projected part vectors and
        the visibility mask. parts:(B,5,768) -> (B,5,512) normalized, vis:(B,5)."""
        proj = self.project_parts(parts)                # (B,5,512)
        proj = F.normalize(proj, dim=2)
        proj = proj * vis.float().unsqueeze(-1)          # zero out invisible parts
        return proj


# ============================================================================
# 3. Losses. Mirrors loss/triplet_loss.py (batch-hard soft-margin) + plain CE.
# ============================================================================
def euclidean_dist(x, y):
    """Pairwise euclidean distance, same as loss/triplet_loss.euclidean_dist."""
    m, n = x.size(0), y.size(0)
    xx = torch.pow(x, 2).sum(1, keepdim=True).expand(m, n)
    yy = torch.pow(y, 2).sum(1, keepdim=True).expand(n, m).t()
    dist = xx + yy - 2 * torch.matmul(x, y.t())
    dist = dist.clamp(min=1e-12).sqrt()
    return dist


def batch_hard_triplet(feat, labels, margin=None, normalize_feature=False):
    """Batch-hard triplet. margin=None -> soft-margin (SoftMarginLoss), matching
    repo TripletLoss default. Returns (loss, mean_dist_ap, mean_dist_an)."""
    if normalize_feature:
        feat = F.normalize(feat, dim=1)
    dist_mat = euclidean_dist(feat, feat)               # (N,N)
    N = dist_mat.size(0)
    is_pos = labels.expand(N, N).eq(labels.expand(N, N).t())
    is_neg = labels.expand(N, N).ne(labels.expand(N, N).t())
    # hardest positive = max pos dist; hardest negative = min neg dist
    dist_ap = (dist_mat * is_pos.float()).max(dim=1)[0]
    # for negatives, set positives to +inf so min picks a true negative
    neg_dist = dist_mat + (~is_neg).float() * 1e12
    dist_an = neg_dist.min(dim=1)[0]
    y = torch.ones_like(dist_an)
    if margin is not None:
        loss = F.margin_ranking_loss(dist_an, dist_ap, y, margin=margin)
    else:
        loss = F.soft_margin_loss(dist_an - dist_ap, y)
    return loss, dist_ap.mean(), dist_an.mean()


# ============================================================================
# 4. PK sampler over cached features. P ids x K imgs = BS. Pure-index sampler:
#    yields lists of dataset indices; the train loop slices cached tensors.
# ============================================================================
class PKSampler:
    """Yields batches of indices: P distinct identities, K images each.
    Identities with < K images are sampled WITH replacement to fill K (standard
    RandomIdentitySampler behaviour). Length = floor(num_imgs / BS) batches/epoch."""
    def __init__(self, pids, P=16, K=4, seed=0):
        self.P, self.K = P, K
        self.bs = P * K
        self.rng = np.random.RandomState(seed)
        self.pid2idx = {}
        for i, p in enumerate(pids):
            self.pid2idx.setdefault(int(p), []).append(i)
        self.pids = list(self.pid2idx.keys())
        self.num_imgs = len(pids)
        # usable identities must have >=1 image (all do). batches per epoch:
        # guard >=1 so tiny --limit_train (dry-run) still yields a batch.
        self.num_batches = max(1, self.num_imgs // self.bs)

    def __len__(self):
        return self.num_batches

    def __iter__(self):
        avail = list(self.pids)

