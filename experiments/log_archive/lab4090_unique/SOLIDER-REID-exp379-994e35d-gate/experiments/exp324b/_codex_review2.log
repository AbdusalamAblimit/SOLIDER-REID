   281	@torch.no_grad()
   282	def encode_split(head, parts, vis, device, batch=512):
   283	    """Run head over a whole split's cached part features. Returns:
   284	      bn_feats  : (N,512) BNNeck global feat (for cosine retrieval)
   285	      np_parts  : (N,5,512) L2-normalized projected part vectors (for part-MaxSim)
   286	      np_vis    : (N,5) float
   287	    """
   288	    head.eval()
   289	    N = parts.shape[0]
   290	    bn_all = np.zeros((N, head.bottleneck.num_features), dtype=np.float32)
   291	    pp_all = np.zeros((N, NPARTS, head.bottleneck.num_features), dtype=np.float32)
   292	    for i in range(0, N, batch):
   293	        e = min(i + batch, N)
   294	        pt = torch.from_numpy(parts[i:e]).to(device)
   295	        vt = torch.from_numpy(vis[i:e].astype(np.float32)).to(device)
   296	        _, _, bn = head(pt, vt)
   297	        bn_all[i:e] = bn.cpu().numpy()
   298	        pp = head.encode_parts(pt, vt)                   # (b,5,512) normalized
   299	        pp_all[i:e] = pp.cpu().numpy()
   300	    return bn_all, pp_all, vis.astype(np.float32)
