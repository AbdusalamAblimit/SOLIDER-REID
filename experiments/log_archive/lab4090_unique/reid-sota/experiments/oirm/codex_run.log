     1	"""OIRM 遮挡环境构造：把一个 batch 的图变成 K 个"遮挡环境视图"。
     2	
     3	环境 = 同一批图施加不同类型/外观的遮挡（刻意让遮挡外观跨环境多样，使遮挡本身无法当身份线索）。
     4	在【已归一化的 GPU 张量】上操作（训练 transform 之后、喂模型之前）。
     5	
     6	- env 0      : 原图（不贴遮挡）
     7	- 'block'    : 贴随机位置/大小、随机纯色矩形（物体类遮挡）
     8	- 'natural'  : 贴 batch 内另一张图同区域的真实 patch（行人/场景类遮挡，对应 NTP）
     9	
    10	注意：这里的遮挡是"环境定义"用途。OIRM 中遮挡视图是否进 ID 监督由训练器的 MODE 决定，与本模块无关。
    11	"""
    12	import random
    13	
    14	import torch
    15	
    16	
    17	def _rand_rect(H, W):
    18	    ph = random.randint(int(0.25 * H), int(0.55 * H))
    19	    pw = random.randint(int(0.35 * W), int(1.0 * W))
    20	    y0 = random.randint(0, H - ph)
    21	    x0 = random.randint(0, W - pw)
    22	    return y0, x0, ph, pw
    23	
    24	
    25	def paste_block(x):
    26	    """x:(B,C,H,W) 归一化张量 → 每图贴一个随机纯色矩形。返回新张量（不改输入）。"""
    27	    B, C, H, W = x.shape
    28	    out = x.clone()
    29	    for i in range(B):
    30	        y0, x0, ph, pw = _rand_rect(H, W)
    31	        color = torch.empty(C, 1, 1, device=x.device, dtype=x.dtype).uniform_(-1, 1)
    32	        out[i, :, y0:y0 + ph, x0:x0 + pw] = color
    33	    return out
    34	
    35	
    36	def paste_natural(x):
    37	    """每图贴 batch 内另一张图同区域的真实 patch（roll 取源，避免贴到自己）。"""
    38	    B, C, H, W = x.shape
    39	    out = x.clone()
    40	    shift = random.randint(1, max(1, B - 1))
    41	    src = torch.roll(x, shifts=shift, dims=0)
    42	    for i in range(B):
    43	        y0, x0, ph, pw = _rand_rect(H, W)
    44	        out[i, :, y0:y0 + ph, x0:x0 + pw] = src[i, :, y0:y0 + ph, x0:x0 + pw]
    45	    return out
    46	
    47	
    48	_OCCLUDERS = {'block': paste_block, 'natural': paste_natural}
    49	
    50	
    51	def make_environments(x, n_env=3, occluder='mixed'):
    52	    """返回 K=n_env 个环境视图的列表，env[0] 恒为原图。
    53	
    54	    occluder='mixed' 时，env1..K-1 在 {block,natural} 中循环/随机选；否则固定该类型。
    55	    """
    56	    envs = [x]
    57	    types = list(_OCCLUDERS) if occluder == 'mixed' else [occluder]
    58	    for k in range(1, n_env):
    59	        fn = _OCCLUDERS[types[(k - 1) % len(types)]]
    60	        envs.append(fn(x))
    61	    return envs

