   357	        kernel_h, kernel_w = self.kernel_size
   358	        stride_h, stride_w = self.stride
   359	        output_h = math.ceil(input_h / stride_h)
   360	        output_w = math.ceil(input_w / stride_w)
   361	        pad_h = max((output_h - 1) * stride_h +
   362	                    (kernel_h - 1) * self.dilation[0] + 1 - input_h, 0)
   363	        pad_w = max((output_w - 1) * stride_w +
   364	                    (kernel_w - 1) * self.dilation[1] + 1 - input_w, 0)
