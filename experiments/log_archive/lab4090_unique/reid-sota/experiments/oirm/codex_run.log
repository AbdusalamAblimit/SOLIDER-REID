     3	MODE:
     4	  'baseline' : 只用 env0(原图) 的 ID+triplet。等价普通基线(但用本循环以保证三臂代码路径一致)。
     5	  'patpp'    : 各环境视图都进 ID+triplet(=朴素遮挡增广 PAT++)，无不变性惩罚。
     6	  'oirm'     : patpp 的 ERM + λ·跨环境不变性惩罚。 ⇒ (oirm − patpp) 干净隔离"不变性项"本身的贡献。
     7	
     8	不变性惩罚:
     9	  'irmv1' : 每个环境 e 用虚拟标量 w=1.0 缩放 logits, penalty_e = (d CE_e / d w)^2; 取各环境均值(IRMv1)。
    10	  'fish'  : 惩罚 = 各环境 ID 梯度(对 BNNeck 权重)两两方向不一致 = 1 - 平均余弦(鼓励梯度对齐)。
    11	
    12	注意:
    13	  - irmv1/fish 都需要二阶图(create_graph=True)，与 AMP GradScaler 不兼容 → OIRM 模式强制 fp32(关 AMP)。
    14	  - ERM_CLEAN_ONLY=True 时 ERM 只用 env0、遮挡环境仅进惩罚(更纯的不变性变体)。
    15	  - 推理路径与基线逐字相同(见 do_inference)，eval 口径不变。
    16	"""
    17	import os
    18	import time
    19	
    20	import torch
    21	import torch.nn.functional as F
    22	from torch.cuda.amp import autocast, GradScaler
    23	
    24	from reid.datasets.occlusion_env import make_environments
    25	from reid.engine.trainer import do_inference   # 复用评测
    26	
    27	
    28	def _irmv1_penalty(logits, target, scale):
    29	    """IRMv1: penalty = (∂ CE(scale·logits, target) / ∂ scale)^2。scale 为 requires_grad 的标量 1.0。"""
    30	    loss = F.cross_entropy(logits * scale, target)
    31	    g = torch.autograd.grad(loss, [scale], create_graph=True)[0]
    32	    return (g ** 2).sum()
    33	
    34	
    35	def _fish_penalty(env_id_grads):
    36	    """Fish/梯度对齐: 1 - 各环境 ID 梯度两两平均余弦(越对齐惩罚越小)。env_id_grads: list[tensor]。"""
    37	    if len(env_id_grads) < 2:
    38	        return torch.zeros((), device=env_id_grads[0].device)
    39	    cos_sum, n = 0.0, 0
    40	    for i in range(len(env_id_grads)):
    41	        for j in range(i + 1, len(env_id_grads)):
    42	            cos_sum = cos_sum + F.cosine_similarity(env_id_grads[i][None], env_id_grads[j][None]).squeeze()
    43	            n += 1
    44	    return 1.0 - cos_sum / n
    45	
    46	
    47	def do_train_oirm(cfg, model, train_loader, val_loader, num_query, optimizer, scheduler, loss_fn, device):
    48	    o = cfg.OIRM
    49	    mode = o.MODE
    50	    n_env = o.N_ENV if mode != 'baseline' else 1
    51	    # 公平性: A/B/C 三臂【一律 fp32(关 AMP)】。否则 oirm 因二阶图必须 fp32、而 baseline/patpp 走 AMP，
    52	    # 会把"精度差异"混入 C−B 的归因。统一 fp32 → C−B 干净隔离不变性惩罚本身的贡献。
    53	    use_amp = False
    54	    scaler = GradScaler(enabled=use_amp)
    55	    max_epochs = cfg.SOLVER.MAX_EPOCHS
    56	    log_period = cfg.SOLVER.LOG_PERIOD
    57	    os.makedirs(cfg.OUTPUT_DIR, exist_ok=True)
    58	    print(f'[OIRM] mode={mode} n_env={n_env} occluder={o.OCCLUDER} penalty={o.PENALTY} '
    59	          f'lambda={o.LAMBDA} warmup={o.WARMUP_PENALTY} erm_clean_only={o.ERM_CLEAN_ONLY} amp={use_amp}')
    60	
    61	    model.to(device)
    62	    for epoch in range(1, max_epochs + 1):
    63	        scheduler.step(epoch)
    64	        model.train()
    65	        run_loss, run_pen, acc_c, acc_n = 0.0, 0.0, 0, 0
    66	        pen_on = (mode == 'oirm') and (epoch > o.WARMUP_PENALTY)
    67	        t0 = time.time()
    68	        for it, batch in enumerate(train_loader):
    69	            imgs, pids = batch[0].to(device), batch[1].to(device)
    70	            optimizer.zero_grad()
    71	
    72	            with autocast(enabled=use_amp):
    73	                envs = make_environments(imgs, n_env=n_env, occluder=o.OCCLUDER) if mode != 'baseline' else [imgs]
    74	                erm_terms, id_grads_for_fish, penalties = [], [], []
    75	                cls0 = None
    76	                scale = torch.ones((), device=device, requires_grad=True) if pen_on and o.PENALTY == 'irmv1' else None
    77	                for ei, xe in enumerate(envs):
    78	                    cls_e, feat_e = model(xe, pids)
    79	                    if ei == 0:
    80	                        cls0 = cls_e
    81	                    # ERM 项：MODE 决定哪些环境进 ERM
    82	                    if mode == 'baseline' or mode == 'patpp' or not o.ERM_CLEAN_ONLY or ei == 0:
    83	                        erm_terms.append(loss_fn(cls_e, feat_e, pids))
    84	                    if pen_on and o.PENALTY == 'irmv1':
    85	                        penalties.append(_irmv1_penalty(cls_e, pids, scale))
    86	                    if pen_on and o.PENALTY == 'fish':
    87	                        ce_e = F.cross_entropy(cls_e, pids)
    88	                        gi = torch.autograd.grad(ce_e, model.bottleneck.weight, create_graph=True, retain_graph=True)[0]
    89	                        id_grads_for_fish.append(gi.flatten())
    90	                erm = torch.stack(erm_terms).mean()
    91	                if pen_on and o.PENALTY == 'irmv1':
    92	                    penalty = torch.stack(penalties).mean()
    93	                elif pen_on and o.PENALTY == 'fish':
    94	                    penalty = _fish_penalty(id_grads_for_fish)
    95	                else:
    96	                    penalty = torch.zeros((), device=device)
    97	                loss = erm + o.LAMBDA * penalty
    98	
    99	            scaler.scale(loss).backward()
   100	            scaler.step(optimizer)
   101	            scaler.update()
   102	
   103	            run_loss += erm.item()
   104	            run_pen += float(penalty.item()) if torch.is_tensor(penalty) else 0.0
   105	            acc_c += (cls0.max(1)[1] == pids).sum().item()
   106	            acc_n += pids.size(0)
   107	            if (it + 1) % log_period == 0:
   108	                lr = optimizer.param_groups[0]['lr']
   109	                print(f'Epoch[{epoch}] Iter[{it+1}/{len(train_loader)}] ERM:{run_loss/(it+1):.4f} '
   110	                      f'Pen:{run_pen/(it+1):.4f} Acc:{acc_c/acc_n:.3f} LR:{lr:.2e}')
   111	        print(f'Epoch[{epoch}] done in {time.time()-t0:.1f}s ERM:{run_loss/len(train_loader):.4f} '
   112	              f'Pen:{run_pen/len(train_loader):.4f} Acc:{acc_c/acc_n:.3f} (pen_on={pen_on})')
   113	
   114	        if epoch % cfg.SOLVER.EVAL_PERIOD == 0 or epoch == max_epochs:
   115	            do_inference(cfg, model, val_loader, num_query, device)
   116	
   117	    ckpt = os.path.join(cfg.OUTPUT_DIR, f'transformer_{max_epochs}.pth')
   118	    torch.save(model.state_dict(), ckpt)
   119	    print(f'Saved checkpoint: {ckpt}')
   120	    return ckpt

