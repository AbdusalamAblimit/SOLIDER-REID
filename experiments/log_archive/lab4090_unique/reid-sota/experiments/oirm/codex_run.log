     1	"""ReID 评测：L2 归一 + 欧式距离（≡余弦排序），标准 Market-1501 single-query 协议
     2	（对每个 query 剔除同 pid 且同摄像头的 gallery）。从原 SOLIDER-REID 提炼，去掉 structured/NFC/power-norm 分支。"""
     3	import numpy as np
     4	import torch
     5	
     6	
     7	def euclidean_distance(qf, gf):
     8	    m, n = qf.shape[0], gf.shape[0]
     9	    dist_mat = (torch.pow(qf, 2).sum(dim=1, keepdim=True).expand(m, n) +
    10	                torch.pow(gf, 2).sum(dim=1, keepdim=True).expand(n, m).t())
    11	    dist_mat.addmm_(qf, gf.t(), beta=1, alpha=-2)   # 新版 torch 关键字 API（旧 addmm_(1,-2,..) 已废弃）
    12	    return dist_mat.cpu().numpy()
    13	
    14	
    15	def eval_func(distmat, q_pids, g_pids, q_camids, g_camids, max_rank=50):
    16	    """Market-1501 metric：每个 query 剔除同摄像头同 pid 的 gallery。返回 (cmc, mAP)。"""
    17	    num_q, num_g = distmat.shape
    18	    if num_g < max_rank:
    19	        max_rank = num_g
    20	        print(f"Note: number of gallery samples is quite small, got {num_g}")
    21	    indices = np.argsort(distmat, axis=1)
    22	    matches = (g_pids[indices] == q_pids[:, np.newaxis]).astype(np.int32)
    23	
    24	    all_cmc, all_AP, num_valid_q = [], [], 0.
    25	    for q_idx in range(num_q):
    26	        q_pid, q_camid = q_pids[q_idx], q_camids[q_idx]
    27	        order = indices[q_idx]
    28	        remove = (g_pids[order] == q_pid) & (g_camids[order] == q_camid)
    29	        keep = np.invert(remove)
    30	        orig_cmc = matches[q_idx][keep]
    31	        if not np.any(orig_cmc):
    32	            continue
    33	        cmc = orig_cmc.cumsum()
    34	        cmc[cmc > 1] = 1
    35	        all_cmc.append(cmc[:max_rank])
    36	        num_valid_q += 1.
    37	        num_rel = orig_cmc.sum()
    38	        tmp_cmc = orig_cmc.cumsum()
    39	        y = np.arange(1, tmp_cmc.shape[0] + 1) * 1.0
    40	        tmp_cmc = (tmp_cmc / y) * orig_cmc
    41	        all_AP.append(tmp_cmc.sum() / num_rel)
    42	
    43	    assert num_valid_q > 0, "Error: all query identities do not appear in gallery"
    44	    all_cmc = np.asarray(all_cmc).astype(np.float32).sum(0) / num_valid_q
    45	    return all_cmc, np.mean(all_AP)
    46	
    47	
    48	class R1_mAP_eval:
    49	    def __init__(self, num_query, max_rank=50, feat_norm=True):
    50	        self.num_query = num_query
    51	        self.max_rank = max_rank
    52	        self.feat_norm = feat_norm
    53	
    54	    def reset(self):
    55	        self.feats, self.pids, self.camids = [], [], []
    56	
    57	    def update(self, output):
    58	        feat, pid, camid = output
    59	        self.feats.append(feat.cpu())
    60	        self.pids.extend(np.asarray(pid))
    61	        self.camids.extend(np.asarray(camid))
    62	
    63	    def compute(self):
    64	        feats = torch.cat(self.feats, dim=0)
    65	        if self.feat_norm:
    66	            feats = torch.nn.functional.normalize(feats, dim=1, p=2)
    67	        qf = feats[:self.num_query]
    68	        q_pids = np.asarray(self.pids[:self.num_query])
    69	        q_camids = np.asarray(self.camids[:self.num_query])
    70	        gf = feats[self.num_query:]
    71	        g_pids = np.asarray(self.pids[self.num_query:])
    72	        g_camids = np.asarray(self.camids[self.num_query:])
    73	        distmat = euclidean_distance(qf, gf)
    74	        cmc, mAP = eval_func(distmat, q_pids, g_pids, q_camids, g_camids)
    75	        return cmc, mAP

