   309	class AdaptivePadding(nn.Module):
   310	    """Applies padding to input (if needed) so that input can get fully covered
   311	    by filter you specified. It support two modes "same" and "corner". The
   312	    "same" mode is same with "SAME" padding mode in TensorFlow, pad zero around
   313	    input. The "corner"  mode would pad zero to bottom right.
   314	    Args:
   315	        kernel_size (int | tuple): Size of the kernel:
   316	        stride (int | tuple): Stride of the filter. Default: 1:
   317	        dilation (int | tuple): Spacing between kernel elements.
   318	            Default: 1
   319	        padding (str): Support "same" and "corner", "corner" mode
   320	            would pad zero to bottom right, and "same" mode would
   321	            pad zero around input. Default: "corner".
   322	    Example:
   323	        >>> kernel_size = 16
   324	        >>> stride = 16
   325	        >>> dilation = 1
   326	        >>> input = torch.rand(1, 1, 15, 17)
   327	        >>> adap_pad = AdaptivePadding(
   328	        >>>     kernel_size=kernel_size,
   329	        >>>     stride=stride,
   330	        >>>     dilation=dilation,
   331	        >>>     padding="corner")
   332	        >>> out = adap_pad(input)
   333	        >>> assert (out.shape[2], out.shape[3]) == (16, 32)
   334	        >>> input = torch.rand(1, 1, 16, 17)
   335	        >>> out = adap_pad(input)
   336	        >>> assert (out.shape[2], out.shape[3]) == (16, 32)
   337	    """
