   340	
   341	        super(AdaptivePadding, self).__init__()
   342	
   343	        assert padding in ('same', 'corner')
   344	
   345	        kernel_size = to_2tuple(kernel_size)
   346	        stride = to_2tuple(stride)
   347	        padding = to_2tuple(padding)
   348	        dilation = to_2tuple(dilation)
