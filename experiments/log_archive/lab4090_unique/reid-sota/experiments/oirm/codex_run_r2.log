    55	                 dropout_rate=0.0, neck_feat='before'):
    56	        super().__init__()
    57	        assert transformer_type in _SWIN_FACTORY, \
    58	            f'未知骨干 {transformer_type}，仅支持 {list(_SWIN_FACTORY)}'
    59	        self.neck_feat = neck_feat
    60	        # pretrained='self' 路径：把权重文件路径传给骨干构造，再调 init_weights（自动认 teacher key、strict=False）。
