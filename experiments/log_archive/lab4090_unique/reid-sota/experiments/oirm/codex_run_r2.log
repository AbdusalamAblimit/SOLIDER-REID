    99	                else:
   100	                    penalty = torch.zeros((), device=device)
   101	                loss = erm + o.LAMBDA * penalty
   102	
   103	            scaler.scale(loss).backward()
   104	            scaler.step(optimizer)
   105	            scaler.update()
