    24	    'occluded_reid': OccludedREID,
    25	}
    26	
    27	
    28	def train_collate_fn(batch):
    29	    imgs, pids, camids, viewids, _ = zip(*batch)
    30	    import torch
    31	    pids = torch.tensor(pids, dtype=torch.int64)
    32	    viewids = torch.tensor(viewids, dtype=torch.int64)
    33	    camids = torch.tensor(camids, dtype=torch.int64)
    34	    return torch.stack(imgs, dim=0), pids, camids, viewids
    35	
    36	
    37	def val_collate_fn(batch):
    38	    imgs, pids, camids, viewids, img_paths = zip(*batch)
    39	    import torch
    40	    viewids = torch.tensor(viewids, dtype=torch.int64)
    41	    camids_batch = torch.tensor(camids, dtype=torch.int64)
    42	    return torch.stack(imgs, dim=0), pids, camids, camids_batch, viewids, img_paths
    43	
    44	
    45	def build_transforms(cfg):
    46	    train_t = T.Compose([
    47	        T.Resize(cfg.INPUT.SIZE_TRAIN, interpolation=3),       # 3 = BICUBIC
    48	        T.RandomHorizontalFlip(p=cfg.INPUT.PROB),
    49	        T.Pad(cfg.INPUT.PADDING),
    50	        T.RandomCrop(cfg.INPUT.SIZE_TRAIN),
    51	        T.ToTensor(),
    52	        T.Normalize(mean=cfg.INPUT.PIXEL_MEAN, std=cfg.INPUT.PIXEL_STD),
    53	        RandomErasing(probability=cfg.INPUT.RE_PROB, mode='pixel', max_count=1, device='cpu'),
    54	    ])
    55	    val_t = T.Compose([
    56	        T.Resize(cfg.INPUT.SIZE_TEST),
    57	        T.ToTensor(),
    58	        T.Normalize(mean=cfg.INPUT.PIXEL_MEAN, std=cfg.INPUT.PIXEL_STD),
    59	    ])
    60	    return train_t, val_t
    61	
    62	
    63	def make_dataloader(cfg):
    64	    assert cfg.DATASETS.NAMES in __factory, \
    65	        f'未知数据集 {cfg.DATASETS.NAMES}，支持 {list(__factory)}'
    66	    train_t, val_t = build_transforms(cfg)
    67	    num_workers = cfg.DATALOADER.NUM_WORKERS
    68	
    69	    dataset = __factory[cfg.DATASETS.NAMES](root=cfg.DATASETS.ROOT_DIR)
    70	    num_classes = dataset.num_train_pids
    71	    cam_num = dataset.num_train_cams
    72	    view_num = dataset.num_train_vids
    73	
    74	    train_set = ImageDataset(dataset.train, train_t)
    75	    train_loader = DataLoader(
    76	        train_set, batch_size=cfg.SOLVER.IMS_PER_BATCH,
    77	        sampler=RandomIdentitySampler(dataset.train, cfg.SOLVER.IMS_PER_BATCH, cfg.DATALOADER.NUM_INSTANCE),
    78	        num_workers=num_workers, collate_fn=train_collate_fn, pin_memory=True, drop_last=True,
    79	    )
    80	
    81	    val_set = ImageDataset(dataset.query + dataset.gallery, val_t)
    82	    val_loader = DataLoader(
    83	        val_set, batch_size=cfg.TEST.IMS_PER_BATCH, shuffle=False,
    84	        num_workers=num_workers, collate_fn=val_collate_fn, pin_memory=True,
    85	    )
    86	
    87	    return train_loader, val_loader, len(dataset.query), num_classes, cam_num, view_num
    88	
