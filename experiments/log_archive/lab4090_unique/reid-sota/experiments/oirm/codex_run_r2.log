    26	def weights_init_kaiming(m):
    27	    classname = m.__class__.__name__
    28	    if classname.find('Linear') != -1:
    29	        nn.init.kaiming_normal_(m.weight, a=0, mode='fan_out')
    30	        nn.init.constant_(m.bias, 0.0)
    31	    elif classname.find('Conv') != -1:
    32	        nn.init.kaiming_normal_(m.weight, a=0, mode='fan_in')
    33	        if m.bias is not None:
    34	            nn.init.constant_(m.bias, 0.0)
    35	    elif classname.find('BatchNorm') != -1:
