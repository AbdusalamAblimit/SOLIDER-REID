    51	        self.max_rank = max_rank
    52	        self.feat_norm = feat_norm
    53	
    54	    def reset(self):
    55	        self.feats, self.pids, self.camids = [], [], []
    56	
    57	    def update(self, output):
    58	        feat, pid, camid = output
    59	        self.feats.append(feat.cpu())
    60	        self.pids.extend(np.asarray(pid))
    61	        self.camids.extend(np.asarray(camid))
    62	
    63	    def compute(self):
    64	        feats = torch.cat(self.feats, dim=0)
    65	        if self.feat_norm:
    66	            feats = torch.nn.functional.normalize(feats, dim=1, p=2)
    67	        qf = feats[:self.num_query]
    68	        q_pids = np.asarray(self.pids[:self.num_query])
    69	        q_camids = np.asarray(self.camids[:self.num_query])
    70	        gf = feats[self.num_query:]
    71	        g_pids = np.asarray(self.pids[self.num_query:])
    72	        g_camids = np.asarray(self.camids[self.num_query:])
