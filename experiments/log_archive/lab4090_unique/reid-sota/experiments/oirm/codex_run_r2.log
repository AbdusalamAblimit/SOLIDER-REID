     1	"""损失：干净基线配方 = ID 交叉熵 + soft-margin triplet（经 BNNeck：CE 用 BN 后 cls_score，triplet 用 BN 前 global_feat）。
     2	
     3	从原 SOLIDER-REID make_loss 的"非 list + triplet"基线分支提炼，去掉 center/arcface/maxsim/evidential/SupCon 等分支。
     4	- triplet：TripletLoss(margin=None)→SoftMarginLoss（NO_MARGIN=True），欧式 + batch-hard 挖掘。
     5	- ID：IF_LABELSMOOTH='off'→F.cross_entropy；'on'→CrossEntropyLabelSmooth。
     6	- total = ID_LOSS_WEIGHT*CE + TRIPLET_LOSS_WEIGHT*tri（默认权重 1.0/1.0）。
     7	"""
     8	import torch.nn.functional as F
     9	
    10	from .triplet_loss import TripletLoss
    11	from .softmax_loss import CrossEntropyLabelSmooth
    12	
    13	
    14	def make_loss(cfg, num_classes):
    15	    margin = None if cfg.SOLVER.NO_MARGIN else cfg.SOLVER.MARGIN
    16	    triplet = TripletLoss(margin=margin)   # margin=None → soft-margin（SoftMarginLoss）
    17	
    18	    if cfg.MODEL.IF_LABELSMOOTH == 'on':
    19	        ce = CrossEntropyLabelSmooth(num_classes=num_classes)
    20	    else:
    21	        ce = None
    22	
    23	    w_id = cfg.MODEL.ID_LOSS_WEIGHT
    24	    w_tri = cfg.MODEL.TRIPLET_LOSS_WEIGHT
    25	
    26	    def loss_fn(cls_score, global_feat, target):
    27	        id_loss = ce(cls_score, target) if ce is not None else F.cross_entropy(cls_score, target)
    28	        tri_loss = triplet(global_feat, target)[0]
    29	        return w_id * id_loss + w_tri * tri_loss
    30	
    31	    return loss_fn

