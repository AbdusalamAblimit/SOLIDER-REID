    49	class ReIDModel(nn.Module):
    50	    """SOLIDER-Swin + BNNeck 基线 ReID 模型。"""
    51	
    52	    def __init__(self, num_classes, transformer_type='swin_base_patch4_window7_224',
    53	                 img_size=(384, 128), pretrain_path='', semantic_weight=0.2,
    54	                 with_cp=False, drop_path=0.1, drop_out=0.0, att_drop_rate=0.0,
    55	                 dropout_rate=0.0, neck_feat='before'):
    56	        super().__init__()
    57	        assert transformer_type in _SWIN_FACTORY, \
    58	            f'未知骨干 {transformer_type}，仅支持 {list(_SWIN_FACTORY)}'
    59	        self.neck_feat = neck_feat
    60	        # pretrained='self' 路径：把权重文件路径传给骨干构造，再调 init_weights（自动认 teacher key、strict=False）。
    61	        self.base = _SWIN_FACTORY[transformer_type](
    62	            img_size=img_size,
    63	            drop_path_rate=drop_path,
    64	            drop_rate=drop_out,
    65	            attn_drop_rate=att_drop_rate,
    66	            pretrained=pretrain_path,
    67	            convert_weights=False,   # 'self' 预训练不做 mmcv key 转换（仅 imagenet 才需）
    68	            semantic_weight=semantic_weight,
    69	            with_cp=with_cp,
    70	        )
    71	        if pretrain_path:
    72	            self.base.init_weights(pretrain_path)
    73	        self.in_planes = self.base.num_features[-1]   # Tiny/Small 768, Base 1024
    74	
    75	        self.num_classes = num_classes
    76	        self.classifier = nn.Linear(self.in_planes, num_classes, bias=False)
    77	        self.classifier.apply(weights_init_classifier)
    78	
    79	        self.bottleneck = nn.BatchNorm1d(self.in_planes)   # BNNeck
    80	        self.bottleneck.bias.requires_grad_(False)
    81	        self.bottleneck.apply(weights_init_kaiming)
    82	
    83	        self.dropout = nn.Dropout(dropout_rate)
    84	
    85	    def forward(self, x, label=None):
    86	        global_feat, _ = self.base(x)            # 骨干返回 (pooled_global_feat, featmaps)
    87	        feat = self.bottleneck(global_feat)      # BN 后
    88	        if self.training:
    89	            cls_score = self.classifier(self.dropout(feat))
    90	            return cls_score, global_feat        # CE 用 cls_score(BN后)，triplet 用 global_feat(BN前)
    91	        return feat if self.neck_feat == 'after' else global_feat
