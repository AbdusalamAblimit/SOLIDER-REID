     1	"""OIRM 遮挡环境构造：把一个 batch 的图变成 K 个"遮挡环境视图"。
     2	
     3	环境 = 同一批图施加不同类型/外观的遮挡（刻意让遮挡外观跨环境多样，使遮挡本身无法当身份线索）。
     4	在【已归一化的 GPU 张量】上操作（训练 transform 之后、喂模型之前）。
     5	
     6	- env 0      : 原图（不贴遮挡）
     7	- 'block'    : 贴随机位置/大小、随机纯色矩形（物体类遮挡）
     8	- 'natural'  : 贴 batch 内另一张图同区域的真实 patch（行人/场景类遮挡，对应 NTP）
     9	
    10	注意：这里的遮挡是"环境定义"用途。OIRM 中遮挡视图是否进 ID 监督由训练器的 MODE 决定，与本模块无关。
    11	"""
    12	import random
    13	
    14	import torch
    15	
    16	
    17	def _rand_rect(H, W):
    18	    ph = random.randint(int(0.25 * H), int(0.55 * H))
    19	    pw = random.randint(int(0.35 * W), int(1.0 * W))
    20	    y0 = random.randint(0, H - ph)
    21	    x0 = random.randint(0, W - pw)
    22	    return y0, x0, ph, pw
    23	
    24	
    25	def paste_block(x):
    26	    """x:(B,C,H,W) 归一化张量 → 每图贴一个随机纯色矩形。返回新张量（不改输入）。"""
    27	    B, C, H, W = x.shape
    28	    out = x.clone()
    29	    for i in range(B):
    30	        y0, x0, ph, pw = _rand_rect(H, W)
    31	        color = torch.empty(C, 1, 1, device=x.device, dtype=x.dtype).uniform_(-1, 1)
    32	        out[i, :, y0:y0 + ph, x0:x0 + pw] = color
    33	    return out
    34	
    35	
    36	def paste_natural(x):
    37	    """每图贴 batch 内另一张图同区域的真实 patch（roll 取源，避免贴到自己）。"""
    38	    B, C, H, W = x.shape
    39	    assert B > 1, 'natural 遮挡需 batch>1(否则贴回自己)'
    40	    out = x.clone()
    41	    shift = random.randint(1, B - 1)
    42	    src = torch.roll(x, shifts=shift, dims=0)
    43	    for i in range(B):
    44	        y0, x0, ph, pw = _rand_rect(H, W)
    45	        out[i, :, y0:y0 + ph, x0:x0 + pw] = src[i, :, y0:y0 + ph, x0:x0 + pw]
    46	    return out
    47	
    48	
    49	def paste_mixed(x):
    50	    """每图随机选 block 或 natural 遮挡，并【硬保证】一个 batch 内两类都至少出现一次。"""
    51	    B, C, H, W = x.shape
    52	    assert B > 1, 'mixed 含 natural, 需 batch>1'
    53	    out = x.clone()
    54	    src = torch.roll(x, shifts=random.randint(1, B - 1), dims=0)
    55	    use_natural = [random.random() < 0.5 for _ in range(B)]
    56	    use_natural[0] = False   # 强制至少 1 张 block
    57	    use_natural[1] = True    # 强制至少 1 张 natural
    58	    for i in range(B):
    59	        y0, x0, ph, pw = _rand_rect(H, W)
    60	        if use_natural[i]:
    61	            out[i, :, y0:y0 + ph, x0:x0 + pw] = src[i, :, y0:y0 + ph, x0:x0 + pw]
    62	        else:
    63	            out[i, :, y0:y0 + ph, x0:x0 + pw] = torch.empty(C, 1, 1, device=x.device, dtype=x.dtype).uniform_(-1, 1)
    64	    return out
    65	
    66	
    67	_OCCLUDERS = {'block': paste_block, 'natural': paste_natural, 'mixed': paste_mixed}
    68	
    69	
    70	def make_environments(x, n_env=2, occluder='mixed'):
    71	    """返回 K=n_env 个环境视图的列表，env[0] 恒为原图，env1..K-1 各施加一次指定遮挡。
    72	
    73	    occluder='mixed' 时每图随机 block/natural（两类都现）；'block'/'natural' 为固定单类型。
    74	    注意：每个遮挡环境独立调用 _OCCLUDERS[occluder]，因此 N_ENV>=3 时各遮挡环境是不同随机实现。
    75	    """
    76	    assert occluder in _OCCLUDERS, f'未知 occluder={occluder}，支持 {list(_OCCLUDERS)}'
    77	    envs = [x]
    78	    for _ in range(1, n_env):
    79	        envs.append(_OCCLUDERS[occluder](x))
    80	    return envs

