    28	def _irmv1_penalty(logits, target, scale):
    29	    """IRMv1: penalty = (∂ CE(scale·logits, target) / ∂ scale)^2。scale 为 requires_grad 的标量 1.0。"""
    30	    loss = F.cross_entropy(logits * scale, target)
    31	    g = torch.autograd.grad(loss, [scale], create_graph=True)[0]
    32	    return (g ** 2).sum()
    33	
    34	
    35	def _fish_penalty(env_id_grads):
    36	    """Fish/梯度对齐: 1 - 各环境 ID 梯度两两平均余弦(越对齐惩罚越小)。env_id_grads: list[tensor]。"""
    37	    if len(env_id_grads) < 2:
    38	        return torch.zeros((), device=env_id_grads[0].device)
    39	    cos_sum, n = 0.0, 0
    40	    for i in range(len(env_id_grads)):
    41	        for j in range(i + 1, len(env_id_grads)):
    42	            cos_sum = cos_sum + F.cosine_similarity(env_id_grads[i][None], env_id_grads[j][None]).squeeze()
    43	            n += 1
    44	    return 1.0 - cos_sum / n
    45	
    46	
