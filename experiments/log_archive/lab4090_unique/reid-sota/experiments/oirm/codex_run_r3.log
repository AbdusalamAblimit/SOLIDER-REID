    51	                    batch_idxs = []
    52	
    53	        avai_pids = copy.deepcopy(self.pids)
    54	        final_idxs = []
    55	
    56	        while len(avai_pids) >= self.num_pids_per_batch:
    57	            selected_pids = random.sample(avai_pids, self.num_pids_per_batch)
    58	            for pid in selected_pids:
    59	                batch_idxs = batch_idxs_dict[pid].pop(0)
    60	                final_idxs.extend(batch_idxs)
    61	                if len(batch_idxs_dict[pid]) == 0:
    62	                    avai_pids.remove(pid)
    63	
